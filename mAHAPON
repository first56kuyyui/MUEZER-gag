                        -- ★ anti warp-back guard: re-assert ถ้าเซิร์ฟดึงกลับ 1.2s (ตาม movement ปกติได้ = ไม่สู้เกมจนเตะ)
                        ugStartAntiWarpGuard(char, yaw, root.Position)
                end
                -- ★ (v43) ถอดระบบล็อคตำแหน่งหลังขึ้นผิวออก: การ "ดึงตัวกลับ" ของเราเองคือ teleport จากมุมมอง
                -- เกม เกมเลยจับซ้ำ ๆ จนขาล็อค/เตะ NO CLIP ตอนกดขึ้นพอดี ตอนนี้ขึ้นผิวด้วยการกระโดด
                -- ฟิสิกส์จริง (jump exit) เกมยอมรับตำแหน่งใหม่เองตามปกติ ไม่ต้องล็อค/ดึงอะไรทั้งนั้น
                lastGroundY = nil
                lastChar = nil
                printedGround = false
