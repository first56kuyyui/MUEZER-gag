        local function drawPreview(container, style, len, th, gap, col, op, oon, ocol)
                for _, c in ipairs(container:GetChildren()) do
                        if c.Name ~= "Bg" and c.Name ~= "Label" and c.Name ~= "Selected" then
                                c:Destroy()
                        end
                end
                local S = len * 2
                local bladeLen = S * 1.2
                local bladeW = math.max(2, th + 1)

                -- ═══════════ 24 สไตล์แบบ shuriken/energy blade ═══════════
                if style == "ใบดาบคลื่น" then
                        -- ฟันใบมีด 6 อัน สีน้ำเงิน-น้ำทะเล + วงแหวน
                        makeRing(container, S*1.4, 1, col, op, oon, ocol)
                        for i = 0, 5 do
                                makeBladeCurved(container, bladeLen, bladeW+1, i*60, col, op, oon, ocol)
                        end
                        makeCenterGlow(container, th+4, col, op*0.5)
                elseif style == "เพลิงเผา" then
                        -- ไฟ 4 อัน สีแดง-ส้ม
                        for i = 0, 3 do
                                makeBladeWide(container, bladeLen, bladeW+2, i*90, col, op, oon, ocol)
                        end
                        makeCenterGlow(container, th+3, col, op*0.4)
                elseif style == "เงา" then
                        -- เงาม่วง 8 อัน
                        for i = 0, 7 do
                                makeBladeCurved(container, bladeLen, bladeW, i*45, col, op, oon, ocol)
                        end
                        makeRing(container, S*0.5, 1, col, op, false)
                elseif style == "แสงศักดิ์สิทธิ์" then
                        -- แสงทอง 12 อัน + วงกลม
                        makeRing(container, S*1.5, 2, col, op, oon, ocol)
                        for i = 0, 11 do
                                local l = (i % 2 == 0) and bladeLen or bladeLen * 0.6
                                makeBlade(container, l, bladeW, i*30, col, op, oon, ocol)
                        end
                        makeCenterGlow(container, th+5, col, op*0.3)
                elseif style == "แกนเทค" then
                        -- วงจรเทคโนโลยี 4 อัน + วงแหวน
                        makeRing(container, S*1.6, 1, col, op, oon, ocol)
                        makeRing(container, S*0.8, 1, col, op, false)
                        for i = 0, 3 do
                                makeBladeWide(container, bladeLen*0.9, bladeW, i*90, col, op, oon, ocol)
                        end
                        makeCenterGlow(container, th+3, col, op*0.5)
                elseif style == "โซ่พิโรธ" then
                        -- โซ่ม่วง-ดำ 8 อันสั้น
                        for i = 0, 7 do
                                makeBlade(container, bladeLen*0.7, bladeW+1, i*45, col, op, oon, ocol)
                                local a = math.rad(i*45 + 22.5)
                                makeCenterGlow(container, 2, col, op*0.6)
                        end
