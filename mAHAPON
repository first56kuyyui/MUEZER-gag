                        local tip_base_name = function(name)
                                return tostring(name):gsub("_unlocked$", ""):gsub("_T%d+$", "")
                        end
                        local tip_prices = {}
                        local function tip_price(name)
                                local base = tip_base_name(name)
                                if tip_prices[base] ~= nil then return tip_prices[base] end
                                local price = 0
                                if items_list_folder then
                                        local entry = items_list_folder:FindFirstChild(base) or items_list_folder:FindFirstChild(tostring(name))
                                        local props = entry and entry:FindFirstChild("ItemProperties")
                                        price = props and tonumber(props:GetAttribute("Price")) or 0
                                end
                                if #tip_prices < 2000 then tip_prices[base] = price end
                                return price
                        end
                        local tip_comma = function(n)
                                local s = tostring(mathfloor(n + 0.5))
                                return s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
                        end
                        local tip_escape = function(s)
