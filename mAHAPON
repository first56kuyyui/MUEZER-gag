                local char = LocalPlayer.Character
                local hrp = char and _FindFirstChild(char, "HumanoidRootPart")
                local hum = char and _FindFirstChildOfClass(char, "Humanoid")

                if not (hrp and hum) then return end

                local aa = cheat.antiaim_state
                -- [fps fix v49] ตอนปิดอยู่ไม่เขียน AutoRotate ทุกเฟรม (เขียนเฉพาะตอนค่าเปลี่ยน) ปิดเมื่อไหร่คืนค่าเดิมให้เอง
                if not aa.enabled then
                        if not hum.AutoRotate then hum.AutoRotate = true end
                        return
                end
                hum.AutoRotate = false
                if aa.enabled then
                        local _, calc_yaw, _ = Camera.CFrame:ToOrientation()

                        if aa.pitch then
                                updatetilt_remote:FireServer(aa.pitch_value, 0)
                        end
                        if aa.yaw then
                                calc_yaw += aa.yaw_value
                        end
                        if aa.jitter then
                                jitter_timer += delta
                                if jitter_side then
                                        calc_yaw += aa.jitter_value
                                else
                                        calc_yaw -= aa.jitter_value
                                end
                                if jitter_timer > 1/32 then
                                        jitter_side = not jitter_side
                                        jitter_timer = jitter_timer % (1/32)
                                end
                        end
                        if aa.spin then
                                calc_yaw += ((tick() * aa.spin_value) % 1) * (math.pi * 2)
                        end

                        local hrp_x, _, hrp_z = hrp.CFrame:ToOrientation()
                        hrp.CFrame = _CFramenew(hrp.Position) * CFrame.Angles(hrp_x, calc_yaw, hrp_z)
                end
        end))
end

