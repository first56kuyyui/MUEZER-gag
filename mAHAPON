                        local ugExitSurf = UGSurfaceAtXZ(root.Position.X, root.Position.Z, root.Position.Y + 6, char)
                        -- ★ v48 กันตกแมพ: ถ้าเรย์เจอพื้นลึกกว่า root.Y - 3 (ห้องใต้ดิน/ถ้ำใต้แมพ ไม่ใช่ผิวจริง)
                        --   ไม่ใช้ค่านั้น ใช้ lastGroundY (ผิวที่ track มาตลอดตอนมุด) แทน กันโผล่ที่พื้นลึก = ตกแมพ
                        if ugExitSurf and ugExitSurf < root.Position.Y - 3 then
                            ugExitSurf = nil
                        end
                        ugExitSurf = ugExitSurf or lastGroundY or root.Position.Y
                        local upY = ugExitSurf + ((stopRootHeight and stopRootHeight > 0.5) and stopRootHeight or 3.5) + 0.2
                        local yaw = ugViewYaw or lastYaw or 0
                        pcall(function()
                            root.Anchored = false
                            root.CFrame = CFrame.new(root.Position.X, upY, root.Position.Z)
