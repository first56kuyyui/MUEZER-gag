                                for i = 1, cnt do
                                        local c = players[i].Character
                                        if c then
                                                list[#list + 1] = c
                                        end
                                end
                        end
                        rayParams.FilterDescendantsInstances = list
                        ugWaterParams.FilterDescendantsInstances = list
                end
        end

        local function ProbeGround(root)
                local startY = (lastGroundY or root.Position.Y) + 5
                BuildExclude()
                local hit = ugRay(
                        workspace,
                        Vector3.new(root.Position.X, startY, root.Position.Z),
                        Vector3.new(0, -500, 0),
                        rayParams
                )
                if hit and hit.Normal.Y >= 0.5 then
                        local y = hit.Position.Y
                        if not lastGroundY then
                                -- ★ v48 กันตกแมพ: เฟรมแรก (lastGroundY ยังว่าง) ต้องเจอพื้นใกล้ผิวเริ่มต้น
                                --   root เพิ่งจมอยู่ผิว พื้นจริงควรใกล้ root.Y ถ้าเจอพื้นลึกกว่า root.Y - 5
                                --   (ห้องใต้ดิน/ถ้ำ/โครงสร้างใต้แมพ) ไม่รับ = กัน lastGroundY ติดค่าลึกแล้วตัวดิ่งลงตกแมพ
                                if y >= root.Position.Y - 5 then
                                        lastGroundY = y
                                        return true
                                end
                        elseif math.abs(y - lastGroundY) <= 12 then
                                lastGroundY = y
                                return true
                        end
                end
                if not lastGroundY then
                        -- ray ไม่เจอดิน = อาจมุดลงน้ำ/อยู่นอกเกาะ ลองหาผิวน้ำเป็นผิวอ้างอิง
                        ugWaterParams.FilterDescendantsInstances = rayParams.FilterDescendantsInstances
                        local ugWHit = ugRay(
                                workspace,
                                Vector3.new(root.Position.X, root.Position.Y + 5, root.Position.Z),
                                Vector3.new(0, -500, 0),
                                ugWaterParams
                        )
                        if ugWHit then
                                local ugWName = ugWHit.Instance.Name:lower()
                                if ugWHit.Material == Enum.Material.Water
                                        or ugWName:find("water", 1, true)
                                        or ugWName:find("ocean", 1, true)
                                        or ugWName:find("sea", 1, true)
                                        or ugWName:find("lake", 1, true) then
                                        lastGroundY = ugWHit.Position.Y
                                        return false
                                end
                        end
                        -- ไม่มีดินไม่มีน้ำ (โหว่) ใช้ตำแหน่งตัวเป็นผิว ไม่ดิ่งลงลึกกว่าเดิม
                        lastGroundY = root.Position.Y
                end
                return false
        end

        -- ★ UG sink fix: หาผิวจริงเหนือหัวใหม่ + ไล่ตัวขึ้นผิวแบบนุ่ม ๆ (กันจมค้าง/กันเกมจับ teleport)
        local ugSpeedSmooth = nil
        -- ★ UG speed sync fix: WalkSpeed ต้นฉบับ + สถานะซิงค์ (กันโดนเตะตอนปรับความเร็ว 1.1+)
        local ugBaseWalkSpeed = nil
        local ugWalkSynced = false
        local ugRising = false
        local ugRiseTargetY = nil
        local ugProbeSurface = nil
        local ugStartRise = nil
        local UGSurfaceAtXZ = nil
        local ugStartExitGuard = nil
        ugProbeSurface = function(root, char)
                if not root or not root.Parent then
                        return nil
                end
                -- ★ FPS fix v44: แคช RaycastParams + exclude list (เดิมสร้าง object ใหม่ทุกเฟรมตอนไต่
                --   = ขยะ GC ต่อเฟรม คือหนึ่งในสาเหตุ FPS ตกช่วงกดขึ้น)
                local ugUpNow = tick()
                if not ugUpParams or ugUpExclChar ~= char or ugUpNow - ugUpExclAt >= 0.5 then
                        ugUpExclChar = char
                        ugUpExclAt = ugUpNow
                        ugUpParams = ugUpParams or RaycastParams.new()
                        ugUpParams.FilterType = Enum.RaycastFilterType.Exclude
                        ugUpParams.IgnoreWater = true
                        ugUpParams.RespectCanCollide = true
                        local exclList = {}
                        if char then
                                exclList[#exclList + 1] = char
                        end
                        local ugExclList = rayParams.FilterDescendantsInstances
                        if ugExclList then
                                for _, inst in ipairs(ugExclList) do
                                        exclList[#exclList + 1] = inst
                                end
                        end
                        ugUpParams.FilterDescendantsInstances = exclList
                end
                local upHit = ugRay(
                        workspace,
                        Vector3.new(root.Position.X, root.Position.Y + 3, root.Position.Z),
                        Vector3.new(0, -400, 0),
                        ugUpParams
                )
                if upHit and upHit.Normal.Y >= 0.5 then
                        return upHit.Position.Y
                end
                return nil
        end
        -- ★ v45: หาผิวดิน "ตามพิกัด" (x, z) ใด ๆ - ยิงเรย์ลงจาก fromY (ใช้ตอนขึ้นผิวที่จุดเริ่มมุด
        --   เพราะตอนขึ้นเราต้องการผิวของจุดเริ่มมุด ไม่ใช่ผิวใต้ตัวที่กำลังจมอยู่)
        UGSurfaceAtXZ = function(ugX, ugZ, ugFromY, ugChar)
                local ugNowT = tick()
                if not ugAtXParams or ugAtXExclChar ~= ugChar or ugNowT - ugAtXExclAt >= 0.5 then
                        ugAtXExclChar = ugChar
                        ugAtXExclAt = ugNowT
                        ugAtXParams = ugAtXParams or RaycastParams.new()
                        ugAtXParams.FilterType = Enum.RaycastFilterType.Exclude
                        ugAtXParams.IgnoreWater = true
                        ugAtXParams.RespectCanCollide = true
                        local ugExclList = {}
                        if ugChar then
                                ugExclList[#ugExclList + 1] = ugChar
                        end
                        local ugBaseExcl = rayParams.FilterDescendantsInstances
                        if ugBaseExcl then
                                for _, ugInst in ipairs(ugBaseExcl) do
                                        ugExclList[#ugExclList + 1] = ugInst
                                end
                        end
                        ugAtXParams.FilterDescendantsInstances = ugExclList
                end
                local ugHit = ugRay(workspace, Vector3.new(ugX, ugFromY, ugZ), Vector3.new(0, -600, 0), ugAtXParams)
                if ugHit and ugHit.Normal.Y >= 0.5 then
                        return ugHit.Position.Y
                end
                return nil
        end
        -- ★ v45 เฝ้าคุ้มหลังโผล่ "รอบเดียวจบ": ถ้าตัวจบลงใต้ผิวดิน (rollback ผิดจุด/ค้างจม)
        --   วางตัวยืนเหนือผิวจริงครั้งเดียวแล้วเลิกทันที ไม่ดีดสวนทุกเฟรม
        --   (เดิม v44 ดีดซ้ำทุกเฟรมนาน 1 วิ = ตีกับเกมจนตัวเด้งลอย แล้วเกมสวนกลับ = จมดินซ้ำ)
        ugStartExitGuard = function(ugChar, ugStandH, ugFallbackY)
                if ugExitGuardConn then
                        pcall(function()
                                ugExitGuardConn:Disconnect()
                        end)
                        ugExitGuardConn = nil
                end
                local ugGuardChar = ugChar
                local ugGuardStandH = (ugStandH and ugStandH > 0.5) and ugStandH or 3.5
                local ugGuardDeadline = tick() + 1.5
                local ugGuardDone = false
                ugExitGuardConn = ugTrackConnection(RunService.Heartbeat:Connect(function()
                        if ugGuardDone or tick() >= ugGuardDeadline then
                                if ugExitGuardConn then
                                        ugExitGuardConn:Disconnect()
                                        ugExitGuardConn = nil
                                end
                                return
                        end
                        local ugGRoot = ugGuardChar and ugGuardChar.Parent
                                and (ugGuardChar:FindFirstChild("HumanoidRootPart") or ugGuardChar.PrimaryPart)
                        if not ugGRoot or not ugGRoot.Parent then
                                if ugExitGuardConn then
                                        ugExitGuardConn:Disconnect()
                                        ugExitGuardConn = nil
                                end
                                return
                        end
                        if ugGRoot.Anchored then
                                return
                        end
                        local ugStandTargetY = nil
                        local ugGSurface = UGSurfaceAtXZ(
                                ugGRoot.Position.X, ugGRoot.Position.Z, ugGRoot.Position.Y + 4, ugGuardChar)
                        if ugGSurface then
                                ugStandTargetY = ugGSurface + ugGuardStandH + 0.2
                        elseif ugFallbackY then
                                ugStandTargetY = ugFallbackY + 0.2
                        end
                        if ugStandTargetY and ugGRoot.Position.Y < ugStandTargetY - 1 then
                                ugGuardDone = true
                                pcall(function()
                                        ugGRoot.CFrame = CFrame.new(ugGRoot.Position.X, ugStandTargetY, ugGRoot.Position.Z)
                                        ugGRoot.AssemblyLinearVelocity = Vector3.zero
                                        ugGRoot.AssemblyAngularVelocity = Vector3.zero
                                        local ugGuardHum = ugGuardChar:FindFirstChildOfClass("Humanoid")
                                        if ugGuardHum and ugGuardHum.Health > 0 then
                                                ugGuardHum:ChangeState(Enum.HumanoidStateType.Running)
                                        end
                                end)
                                print("[MUZER] Underground: จัดตัวยืนเหนือผิวดินหลังโผล่ (รอบเดียวจบ)")
                                if ugExitGuardConn then
                                        ugExitGuardConn:Disconnect()
                                        ugExitGuardConn = nil
                                end
                        end
                end))
        end

        local ugStartAntiWarpGuard = function(ugChar, ugYaw, ugPos)
            -- ★ v46 port from Miko Hub: หลัง emerge 1.2s ถ้าเซิร์ฟดึงตัวกลับ (jump กะทันหัน) ให้ re-assert
            --   กลับจุดที่โผล่ แต่ถ้าผู้เล่นเดินปกติ = ตามไป ไม่สู้เกมจนเตะ (เหมือนของ Miko Hub ที่ใช้ได้จริง)
            if not ugChar or not ugPos then
                return
            end
            local guardChar = ugChar
            local guardYaw = ugYaw or 0
            local guardPos = ugPos
            local anchorPos = ugPos
            local guardStart = tick()
            local guardLast = guardStart
            task.spawn(function()
                while tick() - guardStart < 1.2 do
                    task.wait()
                    local now = tick()
                    local gdt = now - guardLast
                    guardLast = now
                    local gc = LocalPlayer.Character
                    if gc ~= guardChar then
                        return
                    end
                    if active then
                        return
                    end
                    local ghum = gc and gc:FindFirstChildOfClass("Humanoid")
                    local groot = gc and (gc:FindFirstChild("HumanoidRootPart") or gc.PrimaryPart)
                    if not groot or not ghum or ghum.Health <= 0 then
                        return
                    end
                    local gpos = groot.Position
                    local moving = ghum.MoveDirection.Magnitude > 0.05
                    local gstep = (gpos - guardPos).Magnitude
                    local gdriftXZ = (Vector3.new(gpos.X, 0, gpos.Z)
                        - Vector3.new(anchorPos.X, 0, anchorPos.Z)).Magnitude
                    if gstep > 3 + 300 * gdt or (not moving and gdriftXZ > 3) then
                        pcall(function()
                            groot.Anchored = false
                            groot.CFrame = CFrame.new(guardPos)
                                * CFrame.Angles(0, guardYaw, 0)
                            groot.AssemblyLinearVelocity = Vector3.zero
                        end)
                    else
                        guardPos = gpos
                        if moving then
                            anchorPos = gpos
                        end
                    end
                end
            end)
        end
        ugStartRise = function()
                if not active then
                        return false
                end
                local char = LocalPlayer.Character
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
                if not char or not humanoid or not root or humanoid.Health <= 0 then
                        return false
                end
                ugHoldUntil = 0
                -- ★ v44: ยกเลิกเฝ้าคุ้มหลังโผล่ตัวเก่า (ถ้ายังค้าง) กันสวนกับการมุดรอบใหม่
                if ugExitGuardConn then
                        pcall(function()
                                ugExitGuardConn:Disconnect()
                        end)
                        ugExitGuardConn = nil
                end
                local surfaceY = ugProbeSurface(root, char)
                local standH = (savedRootHeight and savedRootHeight > 0.5) and savedRootHeight or 3.5
                local baseY = surfaceY or lastGroundY or root.Position.Y
                local targetY = baseY + standH
                if root.Position.Y < baseY - 0.2 and targetY < root.Position.Y + 2.5 then
                        targetY = root.Position.Y + 2.5
                end
                if root.Position.Y >= targetY - 0.3 then
                        return false
                end
                ugRising = true
                ugRiseTargetY = targetY
                -- ★ v49: ไต่ขึ้น "ไม่ anchor" - anchor = เซิร์ฟตาบอด ไม่รับ movement ไต่ขึ้น
                --   พอโผล่ teleport เซิร์ฟเห็น jump ใหญ่ = จับ teleport → ดึงกลับจุดใต้ดิน (ในพื้น)
                --   → guard สู้ 1.2s (ยืนค้าง) → หมด guard ตัวในพื้น → physics ดันลง = ตกโลก
                --   ไม่ anchor + ไต่ทีละเฟรม + velocity ตรง movement = เซิร์ฟรับตำแหน่งขึ้นปกติ ไม่จับ ไม่ตก
                return true
        end

        stopUnderground = function(ugSkipStandUp)
                active = false
                ugHoldUntil = 0
                ugRising = false
                ugRiseTargetY = nil
                local char = LocalPlayer.Character
                local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
                local stopRootHeight = savedRootHeight
                UGRestoreLocalBody()
                UGRestoreGhostFx()
                if ugStealthAnchored then
