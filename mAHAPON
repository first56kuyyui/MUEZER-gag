                                        }, true)
                                end))
                        end

                        Keybind.Set({ cfg.key, cfg.mode, cfg.value }, true)

                        Library.ConfigFlags[string.format("%s_data", cfg.flag)] = Keybind.Set

                        table.insert(Library.Popups, Keybind)

                        return setmetatable(Keybind, Library)
