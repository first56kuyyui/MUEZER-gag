local function getButtonText(btn)
    if not btn then return nil end
    local ok, txt = pcall(function() return btn.Text end)
    if ok and txt and string.len(txt) > 0 then return txt end
    local ok2, label = pcall(function() return btn:FindFirstChildWhichIsA("TextLabel", true) end)
    if ok2 and label then
        local ok3, t2 = pcall(function() return label.Text end)
        if ok3 and t2 and string.len(t2) > 0 then return t2 end
    end
    return nil
end

local function nameMatchesAny(name, words)
    if not name then return false end
    local lower = string.lower(name)
    for _, w in ipairs(words) do
        if string.find(lower, w, 1, true) then return true end
    end
    return false
end

