                        function Keybind.CancelListening()
                                if Keybind.Listener then
                                        Keybind.Listener:Disconnect( )
                                        Keybind.Listener = nil
                                end

                                -- [keybind fix] เดิมยกเลิกการตั้งปุ่มแล้วช่องค้าง "[....]" ตลอดไป
                                -- ตอนนี้คืนชื่อปุ่มที่ผูกไว้กลับมาทันที โชว์ [ปุ่ม] เหมือนก่อนจะกดตั้ง
                                local restore_name = (Keybind.Key and Keybind.Key ~= Enum.KeyCode.Unknown) and Keybind.Key.Name or "-"
                                Objects.value.Text = string.format("[%s]", KeyConverters[ restore_name:lower() ] or restore_name)

