        end

        cheat.ug_state = { on = false, depth = 0.9, speed = 0.9, syncwalk = true }

        local active = false
        local stopUnderground = nil
        local savedHumanoid = nil
        local savedAutoRotate = true
        local savedCameraOffset = nil
        local savedCameraHeightOffset = nil
        local savedCameraWorldOffset = nil
        local savedRootHeight = nil
        local initialRootY = nil
        local savedCameraY = nil
        local lastChar = nil
        local lastGroundY = nil
        local lastYaw = 0
        local printedGround = false
        local collideSaved = nil
        local ugLastPose = nil
        local ugLastVel = Vector3.zero -- ★ Miko-faithful: velocity ล่าสุดที่ re-assert ทุกเฟรม (ตรงการเคลื่อนไหว = ไม่โดนเตะ speed)
        local ugApplyPose = nil
        local ugSteppedConn = nil
        local ugHeartbeatConn = nil
        local ugCollideParts = nil
        local ugCollidePartsChar = nil
        local ugCollidePartsAt = 0
        local ugCollidePartsConn = nil
        local ugCollideConnChar = nil  -- ★ v52 FPS-leak: track ตัวละครที่ผูก conn (สร้าง conn ครั้งเดียว/ตัว)
        local ugViewYaw = 0
        local ugViewPitch = 0
        local ugEyeHeightY = nil
        local ugInputConn = nil
        local ugHoldUntil = 0
        local ugHoldFxNextScan = 0
        local ugHoldWasActive = false
        local ugStealthAnchored = false
        -- ★ v44 anti-rollback: ธงเกมดึงตำแหน่งกลับ + connection เฝ้าคุ้มหลังโผล่ + แคชเรย์หาผิวตอนไต่
        local ugServerSnapped = false
        local ugExitGuardConn = nil
        local ugUpParams = nil
        local ugUpExclChar = nil
        local ugUpExclAt = 0
        local ugProbeAt = 0  -- ★ v51 FPS: throttle ProbeGround (0.1s)
        -- ★ v45 silent session: จุดเริ่มมุด = จุดที่เซิร์ฟเวอร์เชื่อว่าตัวเรายืนอยู่ตลอดโหมด + แคชเรย์หาผิวตามพิกัด
        local ugServerAnchorPos = nil
        local ugLastFlagAt = 0
        local ugAtXParams = nil
        local ugAtXExclChar = nil
        local ugAtXExclAt = 0
        local UG_MOUSE_SENS = 0.0035

        local ugHiddenParts = {}
        local ugGhostFx = {}
        -- ★ anti-hit: เก็บค่า CanQuery/CanTouch เดิมไว้คืนตอนปิด (ปิด hitbox ตอนมุด ศัตรูยิง/เตะทะลุ)
        local ugHitSaved = {}

        -- dot-call Raycast ตรง ๆ กันโดน hook Raycast ของระบบอื่นในสคริปต์นี้แทรกเส้นเช็คพื้น/น้ำ
        local ugRay = workspace.Raycast

        local UtilityConn = (Library.Utility and Library.Utility.Connections) or nil
        local function ugTrackConnection(conn)
                if conn and UtilityConn then
                        pcall(function()
                                table.insert(UtilityConn, conn)
                        end)
                end
                return conn
        end

        -- ★ FPS fix v38 (ต้นฉบับ): แคชรายชื่อ BasePart ของตัวละคร — เดิม ugApplyPose
        --   (Stepped+Heartbeat) กับสายเคลื่อนที่เดิน char:GetDescendants() รวม 3 ครั้ง/เฟรม
        --   = สร้างตารางขยะหลักร้อยชิ้นต่อเฟรม = ตัวการหลัก FPS ตก ตอนนี้แคชครั้งเดียวต่อตัว
        --   เติมชิ้นใหม่ทันทีผ่าน DescendantAdded และล้างขยะทุก 1 วิ
        local function UGRebuildCollideParts(char)
                local list = {}
                for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                                list[#list + 1] = part
                        end
                end
                ugCollideParts = list
                ugCollidePartsChar = char
                ugCollidePartsAt = tick()
                -- ★ v52 FPS-leak: สร้าง DescendantAdded conn เฉพาะตอนเปลี่ยนตัวละคร
                --   เดิมสร้างใหม่ทุก 1s (UGSyncCollideParts rebuild) = UtilityConn สะสม connection
                --   ตาย 1 ตัว/วิ มุดนาน = พัน entries = GC pressure = FPS ยิ่งตกเรื่อยๆ
                --   conn ปิด upvalue ugCollideParts (ตัวแปร) สร้างครั้งเดียวต่อตัว เห็น list ใหม่อยู่แล้ว
                if ugCollideConnChar ~= char then
                        if ugCollidePartsConn then
                                pcall(function()
                                        ugCollidePartsConn:Disconnect()
                                end)
                        end
                        ugCollideConnChar = char
                        ugCollidePartsConn = ugTrackConnection(char.DescendantAdded:Connect(function(obj)
                                if obj:IsA("BasePart") and ugCollideParts then
                                        ugCollideParts[#ugCollideParts + 1] = obj
                                end
                        end))
                end
                -- ★ v52 FPS-leak: prune part ที่ถูกทำลายแล้ว (Parent=nil) ออกจาก collideSaved/ugHitSaved
                --   เดิมเก็บค่าเดิมของทุก part ที่เคยเจอ ถ้า part ถูกทำลาย (เปลี่ยนอาวุธ/อคเซสเซอรี/
                --   effect ชั่วคราวที่เกมสร้าง-ลบใต้ตัว) entry ค้างอ้าง instance ตาย = Luau ไม่ GC
                --   = memory โตตลอดมุด = GC pressure สะสม = FPS ยิ่งตก มุดยิ่งนานยิ่งเดี้ย
                --   เก็บเฉพาะ part ที่ยังมีชีวิต (Parent ~= nil) จะได้คืน CanCollide/CanQuery/CanTouch
                --   ตอน stopUnderground (stop เองก็ skip part ตายอยู่แล้ว เลยปลอดภัย)
                if collideSaved then
                        local keepC = {}
                        for part, value in pairs(collideSaved) do
                                if part and part.Parent then
                                        keepC[part] = value
                                end
                        end
                        collideSaved = keepC
                end
                if ugHitSaved then
                        local keepH = {}
                        for part, value in pairs(ugHitSaved) do
                                if part and part.Parent then
                                        keepH[part] = value
                                end
                        end
                        ugHitSaved = keepH
                end
        end
        local function UGSyncCollideParts(char)
                if ugCollidePartsChar ~= char or (tick() - ugCollidePartsAt) >= 1 then
                        UGRebuildCollideParts(char)
                end
                return ugCollideParts
        end

        -- Show the prone local character and attached gear without changing replicated Transparency.
        local function UGHidePart(obj, showBody)
                if not obj:IsA("BasePart") and not obj:IsA("Decal") then
                        return
                end
                -- ★ FPS fix v41 (ต้นฉบับ): ชิ้นที่ track แล้วเขียนตรง + เขียนเฉพาะเมื่อค่าเพี้ยน
                local saved = ugHiddenParts[obj]
                if saved then
                        saved.ShowBody = showBody or false
                        local ugLtm = showBody and tick() >= ugHoldUntil and 0 or 1
                        if obj.LocalTransparencyModifier ~= ugLtm then
                                obj.LocalTransparencyModifier = ugLtm
                        end
                        return
                end
                local ok, oldValue = pcall(function()
                        return obj.LocalTransparencyModifier
                end)
                if not ok then
                        return
                end
                ugHiddenParts[obj] = { Value = oldValue, ShowBody = showBody or false }
                obj.LocalTransparencyModifier = showBody and tick() >= ugHoldUntil and 0 or 1
        end

        local function UGRestorePart(obj, saved)
                pcall(function()
                        obj.LocalTransparencyModifier = saved.Value
                end)
                ugHiddenParts[obj] = nil
        end

        local function UGHideLocalBody(char)
                if not char then
                        return
                end
                for _, obj in ipairs(char:GetDescendants()) do
                        UGHidePart(obj, true)
                end
        end

        local function UGHideAttachedGear(char)
                local camera = workspace.CurrentCamera
                local seen = {}
                local queue = {}
                local gear = {}
                for _, name in ipairs({ "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso" }) do
                        local body = char:FindFirstChild(name)
                        if body and body:IsA("BasePart") then
                                queue[#queue + 1] = body
                                seen[body] = true
                        end
                end
                local i = 1
                while i <= #queue do
                        local part = queue[i]
                        i = i + 1
                        local ok, connected = pcall(function()
                                return part:GetConnectedParts(false)
                        end)
                        if ok then
                                for _, other in ipairs(connected) do
                                        if not seen[other] and not other:IsDescendantOf(char)
                                                and not other.Anchored and (not camera or not other:IsDescendantOf(camera)) then
                                                seen[other] = true
                                                local parent = other.Parent
                                                local allowed = true
                                                while parent and parent ~= workspace do
                                                        local name = parent.Name:lower()
                                                        if parent:IsA("Tool") or (parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid"))
                                                                or name:find("weapon", 1, true) or name:find("gun", 1, true)
                                                                or name:find("rifle", 1, true) then
                                                                allowed = false
                                                                break
                                                        end
                                                        parent = parent.Parent
                                                end
                                                if allowed then
                                                        gear[other] = true
                                                        queue[#queue + 1] = other
                                                        UGHidePart(other, true)
                                                        for _, child in ipairs(other:GetDescendants()) do
                                                                if child:IsA("Decal") then
                                                                        gear[child] = true
                                                                        UGHidePart(child, true)
                                                                end
                                                        end
                                                end
                                        end
                                end
                        end
                end
                -- Some games draw a separate body/backpack rig under CurrentCamera.
                -- Hide EVERYTHING under the camera while underground EXCEPT weapon/arms
                -- branches (ปืนกับมือมุมมองบุคคลที่หนึ่งต้องยังเห็นตามปกติ)
                if camera then
                        for _, obj in ipairs(camera:GetDescendants()) do
                                if obj:IsA("BasePart") or obj:IsA("Decal") then
                                        local node = obj
                                        local weaponPart = false
                                        while node and node ~= camera do
                                                local name = node.Name:lower()
                                                if name:find("[%s_%-]") then
                                                        name = name:gsub("[%s_%-]", "")
                                                end
                                                if node:IsA("Tool") or name:find("weapon", 1, true)
                                                        or name:find("rifle", 1, true) or name:find("gun", 1, true)
                                                        or name:find("pistol", 1, true) or name:find("viewmodel", 1, true)
                                                        or name:find("arms", 1, true) or name:find("hands", 1, true)
                                                        or name:find("scope", 1, true) then
                                                        weaponPart = true
                                                end
                                                node = node.Parent
                                        end
                                        -- ช่วง hold ยกตัวยิง ถ้าปืน/มือลอยสูงกว่ากล้องเกิน 1.5 หน่วย ซ่อนชั่วคราว
                                        if not weaponPart then
                                                gear[obj] = true
                                                UGHidePart(obj)
                                        elseif ugHoldUntil and tick() < ugHoldUntil
                                                and obj:IsA("BasePart")
                                                and obj.Position.Y > camera.CFrame.Position.Y + 1.5 then
                                                UGHidePart(obj)
                                        end
                                end
                        end
                end
                -- Restore gear immediately when it is detached or leaves the body model.
                local ugHoldActiveNow = camera and tick() < (ugHoldUntil or 0)
                for obj, saved in pairs(ugHiddenParts) do
                        if not obj:IsDescendantOf(char) and not gear[obj] then
                                if not (ugHoldActiveNow and obj:IsA("BasePart") and obj.Parent
                                        and obj.Position.Y > camera.CFrame.Position.Y + 1.5) then
                                        UGRestorePart(obj, saved)
                                end
                        end
                end
        end

        local function UGRestoreLocalBody()
                for obj, saved in pairs(ugHiddenParts) do
                        UGRestorePart(obj, saved)
