                if ug_depth_slider then ug_depth_slider.State(vis) end
                if ug_speed_slider then ug_speed_slider.State(vis) end
        end

        local ug_toggle = movebox:Toggle({Name = "มุดดิน", Value = false, Flag = "underground", Callback = function(bool)
                cheat.ug_state.on = bool
                if ug_keybind then
                        pcall(ug_keybind.Set, bool, true)
                end
                ugSyncSliders(bool and true or false)
                pcall(function()
                        Library.Notification(bool and "มุดดิน: เปิด — ตัวจมใต้ดินแล้ว เดิน WASD ได้" or "มุดดิน: ปิด — ตัวขึ้นยืนเหนือดินแล้ว", 3)
                end)
        end})
        ug_keybind = ug_toggle:Keybind({Name = "มุดดิน", Mode = "Toggle", Modes = {"Hold", "Toggle"}, Key = Enum.KeyCode.B, Value = false, Flag = "underground_key", Link = "underground", Callback = function(bool)
                cheat.ug_state.on = bool
                pcall(ug_toggle.Set, bool)
                ugSyncSliders(bool and true or false)
        end})
        ug_depth_slider = movebox:Slider({Name = "ความลึกใต้ดิน (สูงสุด 0.9 — เกินนี้ anti-cheat จับใต้ดิน→โผล่แล้วดึงกลับจุดลง)", Min = 0.1, Max = 0.9, Float = 0.1, Value = 0.9, Flag = "underground_depth", Callback = function(int)
                cheat.ug_state.depth = int
        end})
        ug_depth_slider.State(false)
        ug_speed_slider = movebox:Slider({Name = "ความเร็วใต้ดิน (สูงสุด 0.9 — เกินนี้ per-frame displacement เกิน threshold เซิร์ฟปฏิเสธ→ตกแมพ/วาป)", Min = 0.1, Max = 0.9, Float = 0.1, Value = 0.9, Flag = "underground_speed", Callback = function(int)
                cheat.ug_state.speed = int
        end})
        ug_speed_slider.State(false)
        movebox:Toggle({Name = "ซิงค์ความเร็ว (กันโดนเตะ 1.1+)", Value = true, Flag = "underground_syncwalk", Callback = function(bool)
                cheat.ug_state.syncwalk = bool
        end})

        infobox:Textbox({
                Name = "วิธีใช้",
                Value = "มุดดิน (Miko) v45 เงียบสุดต่อเซิร์ฟเวอร์: เปิด toggle หรือกด B ระบบ anchor ตัวไว้ตั้งแต่เริ่มมุด เซิร์ฟเวอร์เห็นตัวเราแช่ยืนที่จุดเริ่มมุดตลอดโหมด ทุกการจม/เดินใต้ดินเป็นฝั่ง client เดียวเกมไม่เห็นแม้แต่บรรทัดเดียว = ไม่ดึงกลับระหว่างมุด ไม่วาปมั่ว ไม่ล็อคขา ไม่เตะ NO CLIP | เดิน WASD ต่อได้ กล้องลอยระดับตาเหนือผิวดินเสมอ ลงน้ำกล้องลอยเหนือผิวน้ำ ตายรีสปอว์นจมต่อให้เอง ระหว่างมุด hitbox ถูกปิด ยิง/เตะของศัตรูทะลุตัว | กดขึ้น (ปิดมุดดิน) = ไต่ขึ้นแบบเงียบแล้วโผล่ที่ 'จุดเริ่มมุด' พอดี (ตรงจุดที่เกมเชื่อว่าเราอยู่ จึงไม่มี teleport ให้จับ ไม่เด้งลอย ไม่จมดิน) เดินต่อได้ทันที | สไลเดอร์ล็อคเพดานปลอดภัย: เร็วสุด 1.2 ลึกสุด 3 ปรับเกินไม่ได้ ความลึกเลื่อนได้อย่างเดียวคือตื้นขึ้น (ลึกเพิ่มไม่ได้) ค่าเริ่มต้น = เร็วสุด ลึกสุด ปลอดภัยสุดแล้ว | โหมดเงียบตัดงานหนักต่อเฟรม (ไม่เขียน WalkSpeed/velocity ทุกเฟรม) FPS ไม่ตก | อย่าเปิดพร้อมกล้องอิสระ (L)",
                Flag = "underground_info",
        })
        infobox:Textbox({
                Name = "ที่มา",
                Value = "ดึงระบบมุดดิน Underground จากสคริปต์ Miko Hub (Project Delta) มาปรับเป็น v45 เงียบสุด: anchor ตัวตลอดโหมด เซิร์ฟเวอร์ไม่เห็นการเคลื่อนที่ใต้ดินเลย (v44 เดิม stream ตอนมุดเดิน = เกมดึงกลับระหว่างมุด + จรวดกระโดด 50 ตอนขึ้น = ตัวเด้งลอย) | ขึ้นผิวที่จุดเริ่มมุดเสมอ เฝ้าคุ้มหลังโผล่รอบเดียวจบ ตัดงานต่อเฟรมลด FPS",
                Flag = "underground_source",
        })
end)();

