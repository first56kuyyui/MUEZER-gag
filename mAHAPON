-- ═══════════ helper ═══════════
local function addLog(text)
    local entry = string.format("[%s] %s", os.date("%H:%M:%S"), tostring(text))
    table.insert(QuestSystem.log_entries, 1, entry)
    if #QuestSystem.log_entries > QuestSystem.max_logs then
        QuestSystem.log_entries[#QuestSystem.log_entries] = nil
    end
    if QuestSystem._updateLog then
        task.spawn(function() QuestSystem._updateLog() end)
    end
end

-- หา QuestUpdate remote อย่างปลอดภัย
-- [แก้กระพริบในแมพ] เกมที่ไม่มี remote นี้ (อย่าง Lone Survival) เดิมทุกครั้งที่หา = WaitForChild 5 วิเต็มๆ
-- ลูปเควสยิงหลาย ID ทุก action ทุกรอบ เลยสตั๊กหนัก + log "not found" ล้น - จำผลหาไว้: เจอ = จำถาวร, ไม่เจอ = เว้น 30 วิค่อยลองใหม่
-- state เก็บใน QuestSystem ไม่ประกาศ local ใหม่ (กันลิมิต 200 register ของ Luau)
QuestSystem.remote_cache = nil
QuestSystem.remote_missed_until = 0
QuestSystem.notfound_last_log = 0
local function getQuestUpdateRemote()
    if QuestSystem.remote_cache then return QuestSystem.remote_cache end
    if os.clock() < QuestSystem.remote_missed_until then return nil end
    local ok, remote = pcall(function()
        return ReplicatedStorage:WaitForChild("Remotes", 5):FindFirstChild("QuestUpdate")
    end)
    if ok and remote then
        QuestSystem.remote_cache = remote
        return remote
    end
    -- ลองหาแบบ recursive
    local ok2, found = pcall(function()
        return ReplicatedStorage:FindFirstChild("QuestUpdate", true)
    end)
    if ok2 and found then
        QuestSystem.remote_cache = found
        return found
    end
    QuestSystem.remote_missed_until = os.clock() + 30
    return nil
end

-- ยิง QuestUpdate remote
local function fireQuestUpdate(action, questId)
    local remote = getQuestUpdateRemote()
    if not remote then
        -- [แก้กระพริบในแมพ] แจ้ง log แค่ครั้งคราว ไม่ลงทุก quest ทุกรอบจน log ล้น
        if os.clock() - QuestSystem.notfound_last_log > 30 then
            QuestSystem.notfound_last_log = os.clock()
            addLog("หา QuestUpdate remote ไม่เจอ!")
        end
        return false
    end
    -- กันไม่ให้ระบบดัก call เรียนรู้ call ที่สคริปต์ยิงเอง (ค่าเดาของสคริปต์ไม่ใช่ค่าจริงของเกม)
    QuestSystem._self_fire_until = os.clock() + 0.1
    local ok, result = pcall(function()
        return remote:InvokeServer(action, questId)
    end)
    if ok then
        addLog(string.format("QuestUpdate(%s, %s) -> %s", action, tostring(questId), tostring(result)))
        return true
    else
        addLog(string.format("QuestUpdate FAIL %s %s: %s", action, tostring(questId), tostring(result)))
        return false
    end
end

-- [Quest chain fix] เดาชื่อเควสภาคต่อจากตัวเลขท้ายของ ID ที่รู้จัก (LeakingTunnelsPt1 -> LeakingTunnelsPt2)
-- และลองต่อท้ายด้วย 2 สำหรับชื่อที่ไม่มีเลข (PilotEpisode -> PilotEpisode2) - เดาไม่ตรงเกมก็แค่ตอบ error ไม่มีผล
local function chainProbeIds()
    local probes = {}
    local seen = {}
    local sources = {}
    for id in pairs(QuestSystem.quest_ids) do sources[#sources + 1] = id end
    for id in pairs(QuestSystem.discovered_ids) do sources[#sources + 1] = id end
    for _, id in ipairs(sources) do
        local head, num = string.match(id, "^(.-)(%d+)$")
        local probe = nil
        if head and head ~= "" and #num <= 3 then
            local next_num = tonumber(num) + 1
            if next_num <= 30 then
                probe = head .. tostring(next_num)
            end
        elseif not string.find(id, "%d", 1, true) then
            probe = id .. "2"
        end
        if probe and not seen[probe] and not QuestSystem.quest_ids[probe] and not QuestSystem.discovered_ids[probe] then
            seen[probe] = true
            probes[#probes + 1] = probe
            if #probes >= 20 then break end
        end
    end
    return probes
end

-- ยิง quest ทั้งหมดในลิสต์ด้วย action ที่กำหนด (quiet = ไม่เขียน log ทุกรอบ กัน log ล้น)
local function fireAllQuests(action, actionName, quiet)
    local count = 0
    local total = 0
    for questId, _ in pairs(QuestSystem.quest_ids) do
        total = total + 1
        if fireQuestUpdate(action, questId) then
            count = count + 1
        end
        -- เว้นช่วงสักนิดระหว่างแต่ละ quest
        task.wait(0.05)
    end
    if QuestSystem.custom_quest_id and QuestSystem.custom_quest_id ~= "" then
        total = total + 1
        if fireQuestUpdate(action, QuestSystem.custom_quest_id) then
            count = count + 1
        end
    end
    -- เควสใหม่ที่ระบบดักเจอเอง ก็ยิงด้วยทุกรอบ (สแนปชอตก่อนวน กันรายการถูกเพิ่มระหว่างยิง)
    local discovered_snapshot = {}
    for did in pairs(QuestSystem.discovered_ids) do
        discovered_snapshot[did] = true
    end
    for questId in pairs(discovered_snapshot) do
        total = total + 1
        if fireQuestUpdate(action, questId) then
            count = count + 1
        end
        task.wait(0.05)
    end
    -- [Quest chain fix] ล่าเควสภาคต่อ: ลองยิงรับชื่อภาคถัดไปที่เดาไว้ด้วยทุกรอบ (เฉพาะตอนรับเควส)
    -- ถ้าเกมมีภาคนั้นจริงจะได้รับเองทันที ไม่ต้องรอระบบดักเจอ ID ก่อน
    if action == ACTION_ACCEPT then
        for _, probe_id in ipairs(chainProbeIds()) do
            total = total + 1
            if fireQuestUpdate(action, probe_id) then
                count = count + 1
            end
            task.wait(0.05)
        end
    end
    if not quiet then
        addLog(string.format("%s: %d/%d quests fired", actionName, count, total))
    end
    return count
end
-- ═══════════ ดักเควสใหม่อัตโนมัติ (Auto Accept New Quests) ═══════════
-- อาการเดิม: สคริปต์ยิง Activate เฉพาะ ID ที่อยู่ในลิสต์เท่านั้น พอเกมส่งเควสใหม่มา
-- (ID ไม่อยู่ในลิสต์) ก็เลยไม่รับให้ -> ระบบนี้ดัก quest ID ตัวใหม่จาก 2 ทาง:
--   1) remote ที่เซิร์ฟเวอร์ยิงเข้า client (OnClientEvent) เช่น ตอนเข้าแมพแล้วเกมแจกเควส
--   2) ข้อมูลเควสที่เกม replicate มาเป็น instance (กล่องชื่อคล้าย Quest/Mission/Task)
-- เจอ ID ใหม่ -> เพิ่มเข้ารายการเอง + log แจ้ง แล้วรับให้ทันทีถ้าเปิด Auto Accept อยู่
-- (ปิด/เปิดระบบนี้ได้ที่ toggle Auto Accept New Quests ในหน้า Settings ของ Auto Quest)
