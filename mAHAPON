        -- ★ FPS fix v39 (ต้นฉบับ): สร้าง exclude ใหม่เมื่อกล้อง/ตัวเรา/จำนวนผู้เล่นเปลี่ยน หรือทุก 0.5 วิ
        local ugExclAt = 0
        local ugExclCam = nil
        local ugExclChar = nil
        local ugExclCount = -1
        local function BuildExclude()
                local cam = workspace.CurrentCamera
                local char = LocalPlayer.Character
                local ok, players = pcall(function()
                        return Players:GetPlayers()
                end)
                local cnt = (ok and players) and #players or 0
                local nowT = tick()
                if nowT - ugExclAt >= 0.5 or cam ~= ugExclCam or char ~= ugExclChar or cnt ~= ugExclCount then
                        ugExclAt = nowT
                        ugExclCam = cam
                        ugExclChar = char
                        ugExclCount = cnt
                        local list = {}
