local function clickGuiButtons(texts, action)
    if not QuestSystem.enabled_clickgui then return 0 end
    if tick() - QuestSystem.last_gui_click < 0.15 then return 0 end
    if not PlayerGui then return 0 end
    local clicked = 0
    local now = tick()
    local ok_guis, guis = pcall(function() return PlayerGui:GetChildren() end)
    if not ok_guis or not guis then return 0 end
    for _, gui in ipairs(guis) do
        local ok_btns, btns = pcall(function() return gui:GetDescendants() end)
        if ok_btns and btns then
            for _, desc in ipairs(btns) do
                local ok_is, isbtn = pcall(function() return desc:IsA("TextButton") or desc:IsA("ImageButton") end)
                if ok_is and isbtn and desc.Visible and desc.Active then
                    local text = getButtonText(desc)
                    -- ข้ามป้ายสถานะ (ส่งงานแล้ว/ส่งรางวัลไป/Claimed/In progress ฯลฯ) - มันเป็นป้ายบอกผลไม่ใช่ปุ่ม
                    if text and not nameMatchesAny(text, QuestSystem.gui_state_texts) and nameMatchesAny(text, texts) then
                        -- [Quest panel flicker fix v2] ปุ่มเดิมที่เพิ่งกดไป เว้น 2 วิ ค่อยกดใหม่ กันกดรัวจนหน้าเควสวิบๆ
                        if QuestSystem.gui_click_memory[desc] and (now - QuestSystem.gui_click_memory[desc]) < QuestSystem.GUI_RECLICK_DELAY then
                            -- เพิ่งกดปุ่มนี้ไป ข้ามรอบนี้
                        else
                            local ok_fire = pcall(function()
                                -- กดหนึ่งครั้ง = ยิง signal เดียวตัวที่เกมต่อจริง
                                -- เดิมยิงทั้ง MouseButton1Click + Activated พร้อมกันทุกครั้ง เกมที่ต่อสองตัวไว้ (จอ+มือถือ)
                                -- เลยโดนสั่งทำงานซ้ำ 2 รอบต่อการกด 1 ครั้ง พวกหน้าเควสเลยติ๊กขึ้นแล้วเลื่อนออกทันที
                                local ok_gc, conns_mbc = pcall(function() return getconnections(desc.MouseButton1Click) end)
                                local ok_gc2, conns_act = pcall(function() return getconnections(desc.Activated) end)
                                local live_mbc = ok_gc and type(conns_mbc) == "table" and #conns_mbc > 0
                                local live_act = ok_gc2 and type(conns_act) == "table" and #conns_act > 0
                                if live_mbc then
                                    firesignal(desc.MouseButton1Click)
                                elseif live_act then
                                    firesignal(desc.Activated)
                                else
                                    -- executor ไม่มี getconnections (หา connection ไม่ได้) ใช้วิธีเดิมยิงทั้งคู่
                                    firesignal(desc.MouseButton1Click)
                                    firesignal(desc.Activated)
                                end
                            end)
                            if ok_fire then
                                QuestSystem.gui_click_memory[desc] = tick()
                                clicked = clicked + 1
                                addLog(string.format("GUI [%s]: %s", action, string.sub(tostring(text), 1, 25)))
                            end
                        end
                    end
                end
            end
        end
    end
    if clicked > 0 then QuestSystem.last_gui_click = tick() end
    return clicked
end

local QUEST_KEYWORDS = { "quest", "mission", "task", "daily", "weekly", "objective", "bounty", "trader", "npc", "boss", "raid" }
local COMPLETE_WORDS = { "complete", "submit", "turnin", "turn in", "handin", "hand in", "deliver", "done", "ส่ง", "ส่งเควส", "ส่งมอบ", "เสร็จ", "สำเร็จ" }
local ACCEPT_WORDS = { "accept", "activate", "start", "begin", "take", "talk", "interact" }
local CLAIM_WORDS  = { "claim", "reward", "collect", "redeem" }

-- [แก้กระพริบในแมพ] จำ prompt ที่เพิ่งยิงไป (weak key) อันเดิมเว้น 2 วิ ค่อยยิงใหม่
-- เดิมยิงทุกป้ายที่แม้วคำ ทุก 0.3 วิ ป้ายคุย NPC/ป้ายเก็บของในแมพเลยวิบๆ ไม่หยุด
-- state เก็บใน QuestSystem ไม่ประกาศ local ใหม่ (กันลิมิต 200 register ของ Luau)
QuestSystem.prompt_fire_memory = setmetatable({}, { __mode = "k" })
QuestSystem.PROMPT_REFIRE_DELAY = 2.0

local function triggerQuestPrompts()
    if not QuestSystem.enabled_prompt then return 0 end
    if tick() - QuestSystem.last_prompt_fire < 0.3 then return 0 end
    local fired = 0
    local ok_desc, descendants = pcall(function() return Workspace:GetDescendants() end)
    if not ok_desc or not descendants then return 0 end
    for _, desc in ipairs(descendants) do
        local ok_is, isprompt = pcall(function() return desc:IsA("ProximityPrompt") end)
        if ok_is and isprompt and desc.Enabled then
            local name = desc.Name or ""
            local obj_text = ""
            local ok_at, at = pcall(function() return desc.ActionText end)
            if ok_at then obj_text = obj_text .. (at or "") end
            local ok_ot, ot = pcall(function() return desc.ObjectText end)
            if ok_ot then obj_text = obj_text .. " " .. (ot or "") end
            local parent_name = ""
            local ok_pn, pn = pcall(function() return desc.Parent and desc.Parent.Name or "" end)
            if ok_pn then parent_name = pn or "" end
            local combined = name .. " " .. obj_text .. " " .. parent_name
            if nameMatchesAny(combined, QUEST_KEYWORDS)
            or nameMatchesAny(combined, ACCEPT_WORDS)
            or nameMatchesAny(combined, CLAIM_WORDS)
            or nameMatchesAny(combined, COMPLETE_WORDS) then
                -- [Quest chain fix] เรียนรู้ชื่อเควสจากป้าย prompt ด้วย (ป้ายคุย NPC เควสภาคต่อมักมีชื่อเควส)
                if QuestSystem.learnFromText then
                    pcall(QuestSystem.learnFromText, obj_text, "prompt")
                    pcall(QuestSystem.learnFromText, parent_name, "prompt")
                end
                -- [แก้กระพริบในแมพ] ป้ายเดิมที่เพิ่งยิงไป เว้น 2 วิ ค่อยยิงใหม่ กันป้ายวิบๆ
                local now_t = tick()
                if QuestSystem.prompt_fire_memory[desc] and (now_t - QuestSystem.prompt_fire_memory[desc]) < QuestSystem.PROMPT_REFIRE_DELAY then
                    -- เพิ่งยิงป้ายนี้ไป ข้ามรอบนี้
                else
                    local ok_fire = pcall(function() fireproximityprompt(desc) end)
                    if ok_fire then
                        QuestSystem.prompt_fire_memory[desc] = tick()
                        fired = fired + 1
                        addLog(string.format("Prompt: %s", string.sub(parent_name, 1, 20)))
                    end
                end
            end
        end
    end
    if fired > 0 then QuestSystem.last_prompt_fire = tick() end
    return fired
end

-- ═══════════ รอบหลัก ═══════════
local function runCycle()
    local total = 0

    -- 1. ยิง QuestUpdate กับทุก quest ID (หลัก)
    if QuestSystem.enabled_accept then
        total = total + fireAllQuests(ACTION_ACCEPT, "Activate")
        clickGuiButtons(GUI_ACCEPT_TEXTS, "Accept")
    end
    if QuestSystem.enabled_complete then
        total = total + fireAllQuests(ACTION_COMPLETE, "Complete")
        clickGuiButtons(GUI_COMPLETE_TEXTS, "Complete")
    end
    if QuestSystem.enabled_claim then
        total = total + fireAllQuests(ACTION_CLAIM, "Claim")
        clickGuiButtons(GUI_CLAIM_TEXTS, "Claim")
    end
    if QuestSystem.enabled_reward then
        total = total + fireAllQuests("Reward", "Reward")
    end
    if QuestSystem.enabled_extra then
        for _, action in ipairs(EXTRA_ACTIONS) do
            total = total + fireAllQuests(action, action)
            task.wait(0.05)
        end
    end
    -- [Auto Send] ส่งเควส/รับเควสบอสต่อเอง - ยิง Complete/Claim + call จริงที่ดักได้
    if QuestSystem.enabled_send then
        if not QuestSystem.enabled_complete then
            total = total + fireAllQuests(ACTION_COMPLETE, "Send-Complete", true)
        end
        if not QuestSystem.enabled_claim then
            total = total + fireAllQuests(ACTION_CLAIM, "Send-Claim", true)
        end
        for action in pairs(QuestSystem.custom_send_actions) do
            total = total + fireAllQuests(action, "Send-" .. action, true)
        end
        clickGuiButtons(GUI_COMPLETE_TEXTS, "Send")
        clickGuiButtons(GUI_CLAIM_TEXTS, "Claim")
        total = total + replayLearnedQuestCalls()
    end

    -- 2. Replay recorded remotes (ถ้าเปิด)
    if QuestSystem.auto_replay and #QuestSystem.recorded_remotes > 0 then
        total = total + replayRecorded()
    end

    -- 3. ProximityPrompt
    if QuestSystem.enabled_accept or QuestSystem.enabled_complete
        or QuestSystem.enabled_claim or QuestSystem.enabled_reward
        or QuestSystem.enabled_extra or QuestSystem.enabled_send then
        triggerQuestPrompts()
    end
end

