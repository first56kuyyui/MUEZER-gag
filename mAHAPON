                                                if cheat.fullbright then fb_scan() end
                                        end))
                                end
                        else
                                for _, c in ipairs(fb_state.conns) do
                                        pcall(function() c:Disconnect() end)
                                end
                                fb_state.conns = {}
                                if fb_state.saved then
                                        for _, p in ipairs({ "Brightness", "Ambient", "OutdoorAmbient", "GlobalShadows", "FogEnd", "ClockTime", "ExposureCompensation" }) do
