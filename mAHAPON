                local function fb_scan()
                        local lighting = game:GetService("Lighting")
                        local fb_containers = { lighting }
                        local fb_cam = workspace.CurrentCamera
                        if fb_cam then fb_containers[#fb_containers + 1] = fb_cam end
                        for _, cont in ipairs(fb_containers) do
                                for _, obj in ipairs(cont:GetChildren()) do
                                        if obj:IsA("PostEffect") then
                                                if fb_state.effects[obj] == nil then
                                                        fb_state.effects[obj] = obj.Enabled
                                                        obj.Enabled = false
                                                end
                                        elseif obj:IsA("Atmosphere") then
                                                if fb_state.atm[obj] == nil then
                                                        fb_state.atm[obj] = { Density = obj.Density, Glare = obj.Glare, Haze = obj.Haze }
                                                        obj.Density = 0
                                                        obj.Glare = 0
                                                        obj.Haze = 0
                                                end
                                        end
                                end
                        end
                end
                local function fb_apply(on)
                        local lighting = game:GetService("Lighting")
                        if on then
                                if fb_state.saved == nil then
                                        fb_state.saved = {
                                                Brightness = lighting.Brightness,
                                                Ambient = lighting.Ambient,
                                                OutdoorAmbient = lighting.OutdoorAmbient,
                                                GlobalShadows = lighting.GlobalShadows,
                                                FogEnd = lighting.FogEnd,
                                                ClockTime = lighting.ClockTime,
                                                ExposureCompensation = lighting.ExposureCompensation
                                        }
                                end
                                for _, p in ipairs({ "Brightness", "Ambient", "OutdoorAmbient", "GlobalShadows", "FogEnd", "ClockTime", "ExposureCompensation" }) do
                                        lighting[p] = fb_state.values[p]
                                end
                                fb_scan()
                                table.insert(fb_state.conns, lighting.ChildAdded:Connect(function(obj)
                                        if cheat.fullbright then fb_scan() end
                                end))
                                table.insert(fb_state.conns, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
                                        if cheat.fullbright then fb_scan() end
                                end))
                                local fb_cam = workspace.CurrentCamera
                                if fb_cam then
