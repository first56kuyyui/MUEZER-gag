                                -- flatten the list (unshrunk heights) so it can be split into balanced columns
                                local elements = {}
                                local function push(kind, a, b, c, h, t)
                                        elements[#elements + 1] = {kind = kind, a = a, b = b, c = c, h = h, tip = t}
                                        full_height += h
                                        full_elems += 1
                                end
                                push("header", data.title, nil, nil, viewer_text_size + 2)
                                for _, section in data.sections do
                                        if #section.rows > 0 then
                                                push("header", section.label, nil, nil, viewer_text_size + 2)
                                                for _, row in section.rows do
                                                        push("row", row.text, row.icon, row.indent or 0, viewer_icon_size + 2, row.tip)
                                                end
                                        end
                                end

                                -- column count: keep every column at most ~42% of the screen height
                                local col_target = math.max(Camera.ViewportSize.Y * 0.42, 160)
                                local cols = math.clamp(math.ceil((full_height + full_elems) / col_target), 1, 6)
                                local per_col = (full_height + full_elems) / cols

                                local col_frame = nil
                                local function new_col(index)
                                        col_frame = Instance.new("Frame")
                                        col_frame.Name = "Col" .. index
                                        col_frame.LayoutOrder = index
                                        col_frame.BackgroundTransparency = 1
                                        col_frame.BorderSizePixel = 0
