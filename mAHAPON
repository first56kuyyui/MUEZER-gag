                -- รอบนี้ใช้ชุดวาดจำลองด้วย Instance เสมอ เพราะ Instance วาดได้จริงทุกตัวรัน
                -- (ตัวเมนูเองก็วาดด้วย Instance และขึ้นปกติบน REAL)

                -- [Real fix v2] เลือก root ด้วยการวัดผลจริง (เช็ค AbsoluteSize ว่าเอนจินวาดจริงไหม)
                local shim_gui = cheat.utility.pick_ui_root("DrawingShim", 999999)

                local function shim_refresh(self)
                        local inst = self._inst
                        if not inst then return end
                        if self._kind == "Text" then
                                inst.Text = self.Text
                                inst.TextSize = self.Size
                                inst.TextColor3 = self.Color
                                inst.TextTransparency = self.Transparency
                                inst.TextStrokeColor3 = self.OutlineColor
                                inst.TextStrokeTransparency = self.Outline and self.Transparency or 1
                                inst.AnchorPoint = self.Center and Vector2.new(0.5, 0.5) or Vector2.new(0, 0)
                                inst.Position = UDim2.fromOffset(self.Position.X, self.Position.Y)
                                inst.ZIndex = self.ZIndex + 1
                                inst.Visible = self.Visible and shim_gui ~= nil or false
                        elseif self._kind == "Circle" then
                                -- [Real fix v3] วงกลมไม่ใช้ UIStroke แล้ว (REAL ไม่วาด UIStroke = วง FOV มองไม่เห็น)
                                -- วาดวงแหวนด้วยเส้น Frame สั้นๆ เรียงรอบวง แบบเดียวกับ snapline ที่ REAL วาดได้จริง
                                -- โหมด Filled = วงทึบด้วย Frame + UICorner (Frame ล้วน วาดได้ทุกตัวรัน)
                                -- เขียนค่าลงเส้นเฉพาะตอนค่าเปลี่ยนจริง (กันยิง property ทิ้งทุกเฟรมเปล่าๆ)
                                local d = math.max(self.Radius * 2, 1)
                                inst.Size = UDim2.fromOffset(d, d)
                                inst.Position = UDim2.fromOffset(self.Position.X, self.Position.Y)
                                inst.ZIndex = self.ZIndex + 1
                                inst.Visible = self.Visible and shim_gui ~= nil or false
                                local fill = self._fill
                                local ring = self._ring
                                if not (fill and ring) then return end
                                local sides = math.clamp(math.floor(self.NumSides or 64), 3, 64)
                                local changed = self._cr ~= self.Radius or self._cth ~= self.Thickness
                                        or self._cc ~= self.Color or self._ct ~= self.Transparency
                                        or self._cn ~= sides or self._cf ~= self.Filled
                                self._cr, self._cth, self._cc, self._ct, self._cn, self._cf
                                        = self.Radius, self.Thickness, self.Color, self.Transparency, sides, self.Filled
                                fill.Visible = self.Filled and inst.Visible or false
                                if self.Filled then
                                        fill.BackgroundColor3 = self.Color
                                        fill.BackgroundTransparency = math.clamp(self.Transparency, 0, 1)
                                        ring.Visible = false
                                        return
                                end
                                ring.Visible = inst.Visible
                                if not changed then return end
                                local radius = math.max(self.Radius, 0.5)
                                local thickness = math.clamp(self.Thickness, 0.5, 6)
                                local seg_len = 2 * radius * math.tan(math.pi / sides) * 1.12 + 1
                                while #ring:GetChildren() < sides do
                                        local seg = Instance.new("Frame")
                                        seg.BorderSizePixel = 0
                                        seg.AnchorPoint = Vector2.new(0.5, 0.5)
                                        seg.Parent = ring
                                end
                                local segs = ring:GetChildren()
                                for i = 1, #segs do
                                        local seg = segs[i]
                                        if i <= sides then
                                                local ang = (i / sides) * math.pi * 2
                                                seg.Visible = true
                                                seg.Position = UDim2.fromOffset(math.cos(ang) * radius + radius, math.sin(ang) * radius + radius)
                                                seg.Rotation = math.deg(ang) + 90
                                                seg.Size = UDim2.fromOffset(seg_len, thickness)
                                                seg.BackgroundColor3 = self.Color
                                                seg.BackgroundTransparency = math.clamp(self.Transparency, 0, 1)
                                        else
                                                seg.Visible = false
                                        end
                                end
                        elseif self._kind == "Line" then
                                local delta = self.To - self.From
                                local len = delta.Magnitude
                                inst.Size = UDim2.fromOffset(math.max(len, 0.01), math.max(self.Thickness, 0.1))
                                inst.Position = UDim2.fromOffset((self.From.X + self.To.X) * 0.5, (self.From.Y + self.To.Y) * 0.5)
                                inst.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                                inst.BackgroundColor3 = self.Color
                                inst.BackgroundTransparency = self.Transparency
                                inst.ZIndex = self.ZIndex + 1
                                inst.Visible = self.Visible and shim_gui ~= nil or false
                        end
                end

                return {
                        new = function(kind)
                                local self = {
                                        _kind = kind,
                                        Visible = false,
                                        Color = Color3.new(1, 1, 1),
                                        Transparency = 0,
                                        ZIndex = 0,
                                        Position = Vector2.new(0, 0),
                                        Text = "",
                                        Size = 13,
                                        Center = false,
                                        Outline = false,
                                        OutlineColor = Color3.new(0, 0, 0),
                                        Radius = 50,
                                        NumSides = 100,
                                        Thickness = 1,
                                        Filled = false,
                                        From = Vector2.new(0, 0),
                                        To = Vector2.new(0, 0),
                                        _inst = nil,
                                        _stroke = nil
                                }

                                if kind == "Text" then
                                        local lbl = Instance.new("TextLabel")
                                        lbl.BackgroundTransparency = 1
                                        lbl.BorderSizePixel = 0
                                        lbl.AutomaticSize = Enum.AutomaticSize.X
                                        lbl.Size = UDim2.fromOffset(0, self.Size + 2)
                                        lbl.Font = Enum.Font.Code
                                        lbl.TextXAlignment = Enum.TextXAlignment.Left
                                        lbl.TextYAlignment = Enum.TextYAlignment.Center
                                        lbl.TextColor3 = self.Color
                                        lbl.TextStrokeColor3 = self.OutlineColor
                                        lbl.TextStrokeTransparency = 1
                                        lbl.TextSize = self.Size
                                        lbl.Text = ""
                                        lbl.ZIndex = 1
                                        lbl.Visible = false
                                        if shim_gui then lbl.Parent = shim_gui end
                                        self._inst = lbl
                                elseif kind == "Circle" then
                                        -- [Real fix v3] วงกลม = Frame ทึบ (โหมด Filled) + วงแหวนเส้น Frame
                                        -- (ตัด UIStroke ทิ้ง - REAL ไม่วาด UIStroke เลยวง FOV ถึงไม่ขึ้น)
                                        local fr = Instance.new("Frame")
                                        fr.BackgroundTransparency = 1
                                        fr.BorderSizePixel = 0
                                        fr.AnchorPoint = Vector2.new(0.5, 0.5)
                                        fr.Size = UDim2.fromOffset(self.Radius * 2, self.Radius * 2)
                                        fr.ZIndex = 1
                                        fr.Visible = false
                                        local fill = Instance.new("Frame")
                                        fill.Size = UDim2.fromScale(1, 1)
                                        fill.BackgroundColor3 = self.Color
                                        fill.BackgroundTransparency = 1
                                        fill.BorderSizePixel = 0
                                        fill.Parent = fr
                                        local fill_corner = Instance.new("UICorner")
                                        fill_corner.CornerRadius = UDim.new(0.5, 0)
                                        fill_corner.Parent = fill
                                        local ring = Instance.new("Frame")
                                        ring.Size = UDim2.fromScale(1, 1)
                                        ring.BackgroundTransparency = 1
                                        ring.BorderSizePixel = 0
                                        ring.Parent = fr
                                        if shim_gui then fr.Parent = shim_gui end
                                        self._inst = fr
                                        self._fill = fill
                                        self._ring = ring
                                elseif kind == "Line" then
                                        local fr = Instance.new("Frame")
                                        fr.BorderSizePixel = 0
                                        fr.AnchorPoint = Vector2.new(0.5, 0.5)
                                        fr.BackgroundColor3 = self.Color
                                        fr.BackgroundTransparency = self.Transparency
                                        fr.ZIndex = 1
                                        fr.Visible = false
                                        if shim_gui then fr.Parent = shim_gui end
                                        self._inst = fr
                                else
                                        error("DrawingShim: unsupported drawing type " .. tostring(kind))
                                end

                                shim_refresh(self)

                                return setmetatable({}, {
                                        __index = function(_, key)
                                                if key == "Remove" then
                                                        return function()
                                                                if self._inst then
                                                                        self._inst:Destroy()
                                                                        self._inst = nil
                                                                        self._stroke = nil
                                                                end
                                                        end
                                                end
                                                return self[key]
                                        end,
                                        __newindex = function(_, key, value)
                                                self[key] = value
                                                shim_refresh(self)
                                        end
                                })
                        end
                }
        end)()

