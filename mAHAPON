-- ══════════════════════════════════════════════════════════
-- [MINE] ควบคุมทุ่นระเบิด - ดึงฟังก์ชันจากสวิท (moneyblox) มาแบบ 100%
-- เปิด Toggle ควบคุมทุ่นระเบิด = ยิงนิ้วทุก 0.5 วิ • โหมดกับดัก: Explode All (จุดระเบิดทุกทุ่นทั้งแมพ) / Deactivate All (ล้มทุ่นทุกอัน)
-- ══════════════════════════════════════════════════════════
do
        local mine_folders = {
                "OutpostLandmines",
                "OutpostClaymores",
                "HeliCrashClaymores",
                "ShipWreckClaymores",
                "BridgeClaymores"
        }

        -- เช็กว่าชื่อ object เป็นกับดัก (landmine/claymore/MON-50)
        -- ======================================================================
        -- ระบบลบกับดัก (Landmine/Claymore) รอบตัว + ปลอมของใน inventory (Fake map)
        -- ======================================================================
        local function is_mine_name(name)
                name = string.lower(name)
                -- จับ MON-50 ด้วย: MON-50 / Mon 50 / MON_50 / mon50 (ตัดสัญลักษณ์กับช่องว่างทิ้งก่อนเทียบ)
                local compact = string.gsub(name, "[^%a%d]", "")
                return string.find(name, "landmine", 1, true) ~= nil or string.find(name, "claymore", 1, true) ~= nil or string.find(name, "mon-50", 1, true) ~= nil or string.find(compact, "mon50", 1, true) ~= nil or string.find(name, "мон", 1, true) ~= nil or string.find(name, "МОН", 1, true) ~= nil or string.find(compact, "pmn", 1, true) ~= nil
        end

        -- จุดจุดชนวน: Trigger / Tripwire / Sensor / Pressure (MON-50, PMN2 ชื่อ part ไม่เหมือนกัน)
        local function is_trigger_name(name)
                name = string.lower(name)
                local compact = string.gsub(name, "[^%a%d]", "")
                return string.find(name, "trigger", 1, true) ~= nil or string.find(compact, "trigger", 1, true) ~= nil or string.find(compact, "tripwire", 1, true) ~= nil or string.find(name, "sensor", 1, true) ~= nil or string.find(name, "pressure", 1, true) ~= nil
        end

        -- ลบกับดักทุกอันใน folder ที่กำหนด
        local function destroy_in(root)
                for _, folder_name in mine_folders do
                        local folder = root:FindFirstChild(folder_name)
                        if folder then
                                for _, mine in folder:GetChildren() do
                                        pcall(function() mine:Destroy() end)
                                end
                        end
                end
        end

        -- วนเรียกฟังก์ชันกับกับดักทุกอันในแผนที่
        local function each_mine(fn)
                local seen = {}
                local function hit(obj)
                        if obj and not seen[obj] then
                                seen[obj] = true
                                fn(obj)
                        end
                end
                local roots = {
                        workspace:FindFirstChild("AiZones"),
                        workspace:FindFirstChild("NoCollision") and workspace.NoCollision:FindFirstChild("AiZones")
                }
                for _, root in roots do
                        if root then
                                for _, folder_name in mine_folders do
                                        local folder = root:FindFirstChild(folder_name)
                                        if folder then
                                                for _, mine in folder:GetChildren() do
                                                        hit(mine)
                                                end
                                        end
                                end
                        end
                end
                -- สแกนทั้งแมพ: เจอชื่อกับดัก หรือ part จุดชนวน (Trigger/Tripwire/Sensor) ในรุ่นไหนก็นับ
                for _, inst in workspace:GetDescendants() do
                        if inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Tool") then
                                if is_mine_name(inst.Name) then
                                        hit((inst:IsA("BasePart") and inst.Parent and inst.Parent:IsA("Model")) and inst.Parent or inst)
                                elseif inst:IsA("BasePart") and is_trigger_name(inst.Name) then
                                        hit(inst:FindFirstAncestorOfClass("Model") or inst)
                                end
                        end
                end
        end

        local mine_manip, mine_mode = false, "Explode All"
        local last_scout = ""
        local miscsec = ui.sections.movement_main
        local mine_mode_dropdown = nil
        local mine_toggle = miscsec:Toggle({Name = "ควบคุมทุ่นระเบิด", Value = false, Flag = "mine_manip_enabled", Callback = function(bool)
                mine_manip = bool
                cheat.feat.mine_manipulation = bool
                if mine_mode_dropdown then mine_mode_dropdown.State(bool) end
        end})
        mine_mode_dropdown = miscsec:Dropdown({Name = "โหมดกับดัก", Values = {"Explode All", "Deactivate All", "ค้นหากับดัก"}, Value = "Explode All", Flag = "mine_manip_mode", Multi = false, Callback = function(str)
                mine_mode = str
        end})
        mine_mode_dropdown.State(false)
        task.spawn(function()
                while task.wait(0.5) do
                        if mine_manip then
                                if mine_mode == "Explode All" and firetouchinterest then
                                        pcall(function()
                                                local char = LocalPlayer.Character
                                                local leg = char and (char:FindFirstChild("LeftLowerLeg") or char:FindFirstChild("HumanoidRootPart"))
                                                if not leg then return end
                                                each_mine(function(mine)
                                                        -- ยิง touch ทุก part ของกับดัก: จับจุดชนวนที่ฝังลึก + ไม่พึ่งชื่อ part (MON-50)
                                                        local parts = {}
                                                        if mine:IsA("BasePart") then parts[#parts + 1] = mine end
                                                        for _, d in mine:GetDescendants() do
                                                                if d:IsA("BasePart") then
                                                                        parts[#parts + 1] = d
                                                                elseif d:IsA("ProximityPrompt") and fireproximityprompt then
                                                                        pcall(fireproximityprompt, d)
                                                                elseif d:IsA("Humanoid") then
                                                                        pcall(function() d.Health = 0 end)
                                                                elseif d:IsA("ValueBase") and (d.Name == "Health" or d.Name == "Hp" or d.Name == "HP") then
                                                                        pcall(function() d.Value = 0 end)
                                                                end
                                                        end
                                                        for _, part in parts do
                                                                pcall(firetouchinterest, leg, part, 0)
                                                                pcall(firetouchinterest, leg, part, 1)
                                                        end
                                                end)
                                        end)
                                elseif mine_mode == "Deactivate All" then
                                        pcall(function()
                                                each_mine(function(mine)
                                                        -- ทำลายจุดจุดชนวนทุกชั้น (Trigger/Tripwire/Sensor); ถ้าไม่มีเลยลบรุ่นทิ้ง
                                                        local found = false
                                                        for _, d in mine:GetDescendants() do
                                                                if d:IsA("BasePart") and is_trigger_name(d.Name) then
                                                                        found = true
                                                                        pcall(function() d:Destroy() end)
                                                                end
                                                        end
                                                        if not found and mine:IsA("Model") then
                                                                pcall(function() mine:Destroy() end)
                                                        end
                                                end)
                                        end)
                                        task.wait(5)
                                elseif mine_mode == "ค้นหากับดัก" then
                                        -- โหมดตรวจหา: แจ้งเตือนชื่อกับดักที่เจอ (ไว้ส่งกลับมาถ้ายังระเบิดไม่ได้)
                                        pcall(function()
                                                local names = {}
                                                each_mine(function(mine)
                                                        if #names < 10 then
                                                                names[#names + 1] = mine.Name .. " " .. (mine:IsA("Model") and "(Model)" or (mine:IsA("Tool") and "(Tool)" or "(Part)"))
                                                        end
                                                end)
                                                local joined = #names > 0 and table.concat(names, ", ") or "ไม่พบกับดักเลย"
                                                if #joined > 200 then joined = string.sub(joined, 1, 200) .. "..." end
                                                if joined ~= last_scout then
                                                        last_scout = joined
                                                        if Library and Library.Notification then
                                                                pcall(Library.Notification, "กับดักที่เจอ: " .. joined, 6)
                                                        end
                                                        print("[MINE SCOUT] " .. joined)
                                                end
                                        end)
                                        task.wait(2)
                                else
                                        task.wait(1)
                                end
                        end
                end
        end)
end

