        -- เด้งขึ้น "ยืน" เหนือผิวดินชั่วคราว (ไว้ให้ระบบยิงเรียกก่อนสร้างกระสุน — ยิงแบบล่องหน)
        -- ยกค้างไว้ 0.45 วิ (ปรับสด: _G.MUZERUG_HoldTime) หมดเวลาจมกลับลงเอง
        _G.MUZERUG_SurfaceNow = function()
                if not active or ugRising then
