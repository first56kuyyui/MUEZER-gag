                        local function icon_of_entry(entry)
                                if not entry then
                                        return nil
                                end
                                local props = entry:FindFirstChild("ItemProperties")
                                if props then
                                        local attr = props:GetAttribute("ItemIcon") or props:GetAttribute("Icon")
                                        if type(attr) == "string" and attr:find("://", 1, true) then
                                                return attr
                                        end
                                        local icon = props:FindFirstChild("ItemIcon")
                                        if icon and icon.Image ~= "" then
                                                return icon.Image
                                        end
                                end
                                local deep = entry:FindFirstChild("ItemIcon", true)
                                if deep and deep:IsA("ImageLabel") and deep.Image ~= "" then
                                        return deep.Image
                                end
                                return nil
                        end

                        local function get_item_icon(item_instance, item_name)
                                local direct = icon_of_entry(item_instance)
                                if direct then
                                        return direct
                                end
                                local cached = icon_cache[item_name]
                                if cached and (cached.image ~= "" or os.clock() - cached.at < 5) then
                                        return cached.image
                                end
                                local resolved = ""
                                if items_list_folder then
                                        resolved = icon_of_entry(items_list_folder:FindFirstChild(item_name)) or ""
                                        if resolved == "" then
                                                local base = tostring(item_name):gsub("_unlocked$", ""):gsub("_T%d+$", "")
                                                for _, entry in items_list_folder:GetChildren() do
                                                        if entry.Name == base or string.find(entry.Name, base, 1, true) or string.find(base, entry.Name, 1, true) then
                                                                local found = icon_of_entry(entry)
                                                                if found then
                                                                        resolved = found
                                                                        break
                                                                end
                                                        end
                                                end
                                        end
                                        icon_cache[item_name] = {image = resolved, at = os.clock()}
                                end
                                return resolved
                        end

