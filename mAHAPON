        -- [ESP แทนอันเก่า] ระบบวาด ESP ผู้เล่นด้วย Frame ล้วน พอร์ตจาก VodkaHub ESP
        -- ตัวรัน REAL วาด Frame/TextLabel ได้จริง แต่ UIStroke/Drawing Line/Adornment ไม่แสดงผล
        -- จึงใช้ Frame เอียงด้วย Rotation เป็นเส้นแทนเส้นทั้งหมด (ค่าทุกอย่างยังมาจากเมนู ESP เดิม)
        -- ======================================================================
        local r15Bones = {{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"}, {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}}
        local r6Bones = {{"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"}}

        -- วาดเส้น 1 เส้นด้วย Frame เดียว: วางกึ่งกลางระหว่างจุด 2 จุด + ยาวเท่าระยะ + หมุนตามมุมจริง
        local function setLineFrame(f, from, to, color, th)
                local dx = to.X - from.X
                local dy = to.Y - from.Y
                local len = math.sqrt(dx * dx + dy * dy)
                if len < 0.5 then f.Visible = false; return end
                f.Position = UDim2.fromOffset(math.floor((from.X + to.X) / 2 + 0.5), math.floor((from.Y + to.Y) / 2 + 0.5))
                f.Size = UDim2.fromOffset(math.floor(len + 0.5), th or 1)
                f.Rotation = math.deg(math.atan2(dy, dx))
                f.BackgroundColor3 = color
                f.Visible = true
        end

        -- มุมกล่อง 4 มุม เลื่อนออกนอก (o บวก) หรือเข้าใน (o ลบ) o พิกเซล ใช้ทำเส้นขอบกล่อง
        local function rectCorners(tl, tr, br, bl, o)
                return _Vector2new(tl.X - o, tl.Y - o), _Vector2new(tr.X + o, tr.Y - o), _Vector2new(br.X + o, br.Y + o), _Vector2new(bl.X - o, bl.Y + o)
        end
        local create_esp, create_object_esp, create_corpse_esp, create_item_esp, destroy_esp;

        create_esp = function(plr_instance)
                local is_npc = plr_instance.ClassName == "Model"
                local is_helicopter = is_npc and plr_instance.Name == "MI24V"

                loaded_plrs[plr_instance] = {
                        obj = {},
                        connections = {}
                }





                local flags_table = {}
                local chams_table = {}

                local registered_flags = esp_table.registered_flags

                local plr = loaded_plrs[plr_instance]
                local obj = plr.obj

                -- [ESP แทนอันเก่า] วัตถุวาด ESP ผู้เล่นทั้งหมด = Frame/TextLabel ล้วน ตามระบบ VodkaHub ESP
                -- ทุกชิ้นเป็นลูกของ container (root ที่ [Real fix v2] เช็คแล้วว่าเอนจินวาดจริง) และลงทะเบียนใน obj
                -- ให้ unload เดิมลบทิ้งเองได้ครบ ปุ่ม/ค่าทุกอันในเมนู ESP เดิมยังเป็นตัวคุมเหมือนเดิม
                local function new_line(th)
                        return esp.create_obj("Frame", {
                                Parent = container,
                                AnchorPoint = Vector2.new(0.5, 0.5),
                                BorderSizePixel = 0,
                                Size = UDim2.fromOffset(10, th),
                                Visible = false,
                                ZIndex = 3
                        }, obj)
                end

                local box_lines = {}
                for i = 1, 4 do box_lines[i] = new_line(1) end

                local outline_out = {}
                local outline_in = {}
                for i = 1, 4 do
                        outline_out[i] = new_line(1)
                        outline_in[i] = new_line(1)
                end

                local skel_lines = {}
                for i = 1, 15 do skel_lines[i] = new_line(1) end

                local health_bg = new_line(2)
                health_bg.BackgroundColor3 = Color3.new(0, 0, 0)
                local health_bar = new_line(2)

                local main_name = esp.create_obj("TextLabel", {
                        Parent = container,
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        TextStrokeTransparency = 0,
                        BorderSizePixel = 0,
                        TextSize = 13,
                        FontFace = Fonts.Get("TahomaXP"),
                        TextColor3 = Color3.new(1, 1, 1),
                        BackgroundTransparency = 1,
                        Size = UDim2.fromOffset(300, 16),
                        Text = plr_instance.Name,
                        Visible = false,
                        ZIndex = 3
                }, obj)

                local main_distance = esp.create_obj("TextLabel", {
                        Parent = container,
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        TextStrokeTransparency = 0,
                        BorderSizePixel = 0,
                        TextSize = 12,
                        FontFace = Fonts.Get("TahomaXP"),
                        TextColor3 = Color3.new(1, 1, 1),
                        BackgroundTransparency = 1,
                        Size = UDim2.fromOffset(150, 16),
                        Text = "0m",
                        Visible = false,
                        ZIndex = 3
                }, obj)

                local main_weapon = esp.create_obj("TextLabel", {
                        Parent = container,
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        TextStrokeTransparency = 0,
                        BorderSizePixel = 0,
                        TextSize = 12,
                        FontFace = Fonts.Get("TahomaXP"),
                        TextColor3 = Color3.new(1, 1, 1),
                        BackgroundTransparency = 1,
                        Size = UDim2.fromOffset(300, 16),
                        Text = "",
                        Visible = false,
                        ZIndex = 3
                }, obj)

                local main_health_text = esp.create_obj("TextLabel", {
                        Parent = container,
                        AnchorPoint = Vector2.new(1, 0.5),
                        TextStrokeTransparency = 0,
                        BorderSizePixel = 0,
                        TextSize = 12,
                        FontFace = Fonts.Get("TahomaXP"),
                        TextColor3 = Color3.new(1, 1, 1),
                        BackgroundTransparency = 1,
                        Size = UDim2.fromOffset(40, 14),
                        Text = "",
                        Visible = false,
                        ZIndex = 3
                }, obj)

                local flag_holder = esp.create_obj("Frame", {
                        Parent = container,
                        BorderSizePixel = 0,
                        Size = UDim2.new(1, 0, 1, 0),
                        Position = UDim2.new(1, 3, 0, -4),
                        BackgroundTransparency = 1,
                }, obj)

                esp.create_obj("UIListLayout", {
                        Parent = flag_holder,
                        SortOrder = Enum.SortOrder.LayoutOrder,
                        VerticalFlex = Enum.UIFlexAlignment.None,
                        Padding = UDim.new(0, -2)
                }, obj)


                for i, v in registered_flags do
                        local flag = esp.create_obj("TextLabel", {
                                Parent = flag_holder,
                                TextStrokeTransparency = 0,
                                BorderSizePixel = 0,
                                TextSize = 9,
                                TextXAlignment = Enum.TextXAlignment.Left,
                                FontFace = Fonts.Get("SmallestPixel7"),
                                TextColor3 = Color3.fromRGB(255, 255, 255),
                                BackgroundTransparency = 1,
                                Size = UDim2.new(1, 0, 0, 10),
                                Text = v[1],
                                Position = UDim2.new(0, 0, 0, -1)
                        }, flags_table)
                        table.insert(obj, flag)
                        esp.create_obj("UIStroke", {
                                Parent = flag,
                                ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
                                LineJoinMode = Enum.LineJoinMode.Miter,
                                Color = Color3.new()
                        }, obj)
                end

                -- [ESP แทนอันเก่า] skeleton เดิมวาดด้วย WireframeHandleAdornment ซึ่งตัวรัน REAL ไม่แสดงผล
                -- เปลี่ยนเป็นเส้น Frame 15 เส้น (skel_lines ด้านบน) ตามระบบ VodkaHub ESP ที่ขึ้นจริงทุกตัวรัน



                local settings = esp_table.settings.enemy
                local main_settings = settings.main_settings

                local character, humanoid, root

                local get_team, get_gun = esp_table.get_team, esp_table.get_gun

                local setvis_cache, skeleton_tick = false, 0
                -- [ESP perf] แคชค่าล่าสุดไว้เทียบ เขียนลง UI เฉพาะตอนค่าเปลี่ยนเท่านั้น
                local last_dist_m, last_health_int = nil, nil
                local last_gun, last_gun_dv = nil, nil
                local last_cham_vis = nil
                local bbox_cache, bbox_pool = table.create(15), {}
                local cham_vis_ok = true
                local vis_state_cache, vis_tick = nil, 0

                -- [ESP แทนอันเก่า] สีกล่อง ปกติ/ตอนมองเห็น อ่านจาก box_color กับ box_visible_color เดิมของเมนู
                local apply_box_color = function(is_visible)
                        local col = is_visible and settings.box_visible_color or settings.box_color
                        for _, ln in pairs(box_lines) do
                                ln.BackgroundColor3 = col[1]
                                ln.BackgroundTransparency = col[3]
                        end
                end

                -- [ESP แทนอันเก่า] forceupdate: ตัวอื่นอ่านค่าเมนูตรง ๆ ใน render ทุกเฟรมแล้ว เหลือ sync ป้าย flags + chams แบบเดิม
                function plr:forceupdate()
                        flag_holder.Visible = settings.flags
                        for _, flag in pairs(flags_table) do
                                flag.TextColor3 = settings.flags_color[1]
                                flag.TextTransparency = settings.flags_color[2]
                        end

                        for part, cham in pairs(chams_table) do
                                cham.cham.Adornee = setvis_cache and settings.chams and (not settings.chams_visible_only or cham_vis_ok) and part or nil
                                cham.cham.Color3 = Color3.new(
                                        settings.chams_color[1].R * settings.chams_glow_factor,
                                        settings.chams_color[1].G * settings.chams_glow_factor,
                                        settings.chams_color[1].B * settings.chams_glow_factor
                                )
                        end
                end

                local destroy_cham_object = function(part)
                        if not chams_table[part] then
                                return
                        end
                        chams_table[part].connection:Disconnect()
                        chams_table[part].cham:Destroy()
                        chams_table[part] = nil
                end

                local create_cham_object = function(part)
                        if not (_IsA(part, "BasePart") and isBodyPart(part.Name)) then return end
                        if chams_table[part] then destroy_cham_object(part) end

                        local cham = esp.create_obj("BoxHandleAdornment", {
                                Parent = container,
                                Size = part.Size * .95,
                                Adornee = setvis_cache and settings.chams and (not settings.chams_visible_only or cham_vis_ok) and part or nil,
                                Color3 = Color3.new(
                                        settings.chams_color[1].R * settings.chams_glow_factor,
                                        settings.chams_color[1].G * settings.chams_glow_factor,
                                        settings.chams_color[1].B * settings.chams_glow_factor
                                ),
                                Transparency = -1,
                                Shading = Enum.AdornShading.XRayShaded,
                                ZIndex = -1,
                                AlwaysOnTop = false
                        }, obj)

                        local conn = part:GetPropertyChangedSignal("Size"):Connect(function()
                                if not (cham and part) then return print("MEMORY LEAK!!!!!!", cham, part) end
                                cham.Size = part.Size * .95
                        end)

                        chams_table[part] = {
                                cham = cham,
                                connection = conn
                        }
                end

                -- [ESP แทนอันเก่า] togglevis: ไม่มี main_holder แล้ว ซ่อน/แสดงทุกชิ้นด้วยมือ + จัดการ chams เหมือนเดิม
                function plr:togglevis(bool, fade)
                        if setvis_cache == bool then return end
                        setvis_cache = bool

                        if not bool then
                                for _, ln in pairs(box_lines) do ln.Visible = false end
                                for _, ln in pairs(outline_out) do ln.Visible = false end
                                for _, ln in pairs(outline_in) do ln.Visible = false end
                                for _, ln in pairs(skel_lines) do ln.Visible = false end
                                health_bg.Visible = false
                                health_bar.Visible = false
                                main_name.Visible = false
                                main_distance.Visible = false
                                main_weapon.Visible = false
                                main_health_text.Visible = false
                                flag_holder.Visible = false
                        else
                                flag_holder.Visible = settings.flags
                        end

                        -- [FPS fix] รีเซ็ตแคช Adornee ของ chams ด้วย เพราะด้านล่างเขียน Adornee ทับหมดแล้ว
                        last_cham_vis = nil
                        for part, cham in pairs(chams_table) do
                                cham.cham.Adornee = bool and settings.chams and (not settings.chams_visible_only or cham_vis_ok) and part or nil
                        end
                end

                function plr:unload()
                        if not loaded_plrs[plr_instance] then return end
                        for i,v in chams_table do
                                v.connection:Disconnect()
                                chams_table[i] = nil
                        end
                        for i,v in plr.connections do
                                v:Disconnect()
                                plr.connections[i] = nil
                        end
                        for i,v in plr.obj do
                                v:Remove()
                                plr.obj[i] = nil
                        end
                        for i,v in plr do
                                plr[i] = nil
                        end
                        loaded_plrs[plr_instance] = nil
                end

                local character_added = function(character)
                        for _, part in character:GetChildren() do
                                create_cham_object(part)
                        end
                        plr.connections["character_childadded"] = character.ChildAdded:Connect(function(part)
                                create_cham_object(part)
                        end)
                        plr.connections["character_childremoved"] = character.ChildRemoved:Connect(function(part)
                                destroy_cham_object(part)
                        end)
                end

                local character_removing = function(character)
                        if plr.connections["character_childadded"] then plr.connections["character_childadded"]:Disconnect() end
                        if plr.connections["character_childremoved"] then plr.connections["character_childremoved"]:Disconnect() end
                        for part, _ in chams_table do
                                destroy_cham_object(part)
                        end
                end

                if is_npc or plr_instance.Character then character_added(is_npc and plr_instance or plr_instance.Character) end
                if not is_npc then
                        plr.connections["character_added"] = plr_instance.CharacterAdded:Connect(character_added)
                        plr.connections["character_removing"] = plr_instance.CharacterRemoving:Connect(character_removing)
                end

                -- [ESP แทนอันเก่า] render ใหม่: วาดด้วย Frame ล้วนตามระบบ VodkaHub ESP อ่านค่าเมนูเดิมทุกเฟรม
                plr.render = function(delta, camera_position, current_tick)
                        skeleton_tick = skeleton_tick + delta

                        if not settings.enabled then
                                return plr:togglevis(false)
                        end

                        if (main_settings.npc_check) and (is_npc) then
                                return plr:togglevis(false)
                        end

                        character = is_npc and plr_instance or plr_instance.Character
                        root = is_helicopter and character.PrimaryPart or character and _FindFirstChild(character, "HumanoidRootPart")
                        humanoid = character and _FindFirstChildOfClass(character, "Humanoid")

                        if not (character and root and humanoid) then
                                return plr:togglevis(false)
                        end

                        local humanoid_health = is_helicopter and root:GetAttribute("Health") or humanoid.Health
                        local humanoid_max_health = is_helicopter and root:GetAttribute("MaxHealth") or humanoid.MaxHealth
                        local humanoid_distance = (camera_position - root.Position).Magnitude

                        if (not is_npc and main_settings.team_check) and get_team(plr_instance, character, humanoid) then
                                return plr:togglevis(false)
                        end

                        if (main_settings.dead_check) and (humanoid_health <= 0) then
                                return plr:togglevis(false)
                        end

                        if (main_settings.dist_check) and (humanoid_distance > main_settings.max_distance) then
                                return plr:togglevis(false)
                        end

                        if (main_settings.visible_check) and not cheat.is_pos_visible(camera_position, root.Position, character) then
                                return plr:togglevis(false)
                        end

                        local _, on_screen = _WorldToViewportPoint(Camera, root.Position)

                        if not on_screen then
                                return plr:togglevis(false)
                        end

                        -- [ESP แทนอันเก่า] มุมกล่อง: มี Head ใช้สูตร VodkaHub ESP (หัว+0.5 / เท้า-3 กว้าง = สูงหาร 2)
                        -- ไม่มี Head (NPC/เฮลิคอปเตอร์) ใช้กล่อง bounding box ระบบเดิม
                        local head_part = (not is_helicopter) and _FindFirstChild(character, "Head")
                        local tl, tr, bl, br

                        if head_part then
                                local hPos, hOn = _WorldToViewportPoint(Camera, head_part.Position + _Vector3new(0, 0.5, 0))
                                local fPos = _WorldToViewportPoint(Camera, root.Position - _Vector3new(0, 3, 0))
                                if not hOn then
                                        return plr:togglevis(false)
                                end
                                local height = math.abs(hPos.Y - fPos.Y)
                                local width = height / 2
                                tl = _Vector2new(hPos.X - width / 2, hPos.Y)
                                tr = _Vector2new(hPos.X + width / 2, hPos.Y)
                                bl = _Vector2new(hPos.X - width / 2, fPos.Y)
                                br = _Vector2new(hPos.X + width / 2, fPos.Y)
                        else
                                local topLeft, bottomRight, cache = nil, nil, bbox_cache
                                table.clear(cache)
                                do
                                        local count = 0
                                        for _, part in pairs(character:GetChildren()) do
                                                if _IsA(part, "BasePart") and isBodyPart(part.Name) then
                                                        local entry = bbox_pool[part.Name]
                                                        if not entry then
                                                                entry = {}
                                                                bbox_pool[part.Name] = entry
                                                        end
                                                        entry[1] = part.CFrame
                                                        entry[2] = part.Size
                                                        cache[part.Name] = entry
                                                        count = count + 1
                                                end
                                        end
                                        if is_helicopter then
                                                cache[root.Name] = {root.CFrame, root.Size}
                                        end
                                        if count <= 0 then
                                                return plr:togglevis(false)
                                        end
                                        topLeft, bottomRight = calculateCorners(getBoundingBox(cache))
                                end
                                tl = _Vector2new(topLeft.X - gui_inset.X, topLeft.Y - gui_inset.Y)
                                br = _Vector2new(bottomRight.X - gui_inset.X, bottomRight.Y - gui_inset.Y)
                                tr = _Vector2new(br.X, tl.Y)
                                bl = _Vector2new(tl.X, br.Y)
                        end

                        plr:togglevis(true)

                        cham_vis_ok = true
                        if settings.chams and settings.chams_visible_only and not is_npc then
                                local po = cheat.player_list and cheat.player_list[plr_instance]
                                cham_vis_ok = po and po.visible or false
                                -- [FPS fix] เดิมเขียน Adornee ทุก part ทุกเฟรมทั้งที่ค่าเดิม - เขียนเฉพาะตอนสถานะเปลี่ยน
                                if cham_vis_ok ~= last_cham_vis then
                                        last_cham_vis = cham_vis_ok
                                        for part, cham in pairs(chams_table) do
                                                cham.cham.Adornee = cham_vis_ok and part or nil
                                        end
                                end
                        end

                        do
                                if settings.box and settings.box_visible_enabled then
                                        vis_tick = vis_tick + delta
                                        if vis_tick >= 0.1 then
                                                vis_tick = 0
                                                local vis_ok = cheat.is_pos_visible(camera_position, root.Position, character)
                                                if not vis_ok then
                                                        local vis_head = _FindFirstChild(character, "Head")
                                                        vis_ok = vis_head and cheat.is_pos_visible(camera_position, vis_head.Position, character) or false
                                                end
                                                vis_ok = vis_ok and true or false
                                                if vis_ok ~= vis_state_cache then
                                                        vis_state_cache = vis_ok
                                                        apply_box_color(vis_ok)
                                                end
                                        end
                                elseif vis_state_cache ~= nil then
                                        vis_state_cache = nil
                                        apply_box_color(false)
                                end
                        end

                        -- ป้าย/หลอดเลือดใช้ตำแหน่งกล่องที่ยังไม่หมุน (ป้ายอยู่บน/ใต้กล่องเหมือนเดิมเสมอ)
                        local cx = (tl.X + tr.X) / 2
                        local box_top_y, box_bot_y = tl.Y, br.Y
                        local box_left_x, box_right_x = tl.X, br.X

                        -- [หมุนกล่อง] เลื่อนสไลเดอร์แล้วกล่องหมุนรอบจุดกึ่งกลางจริง ๆ (เดิมหมุนไล่สีบน UIStroke ซึ่ง REAL ไม่วาด)
                        local rot = settings.box_rotation
                        if rot ~= 0 then
                                local cy = (tl.Y + br.Y) / 2
                                local rad = math.rad(rot)
                                local cosr, sinr = math.cos(rad), math.sin(rad)
                                tl = _Vector2new(cx + (tl.X - cx) * cosr - (tl.Y - cy) * sinr, cy + (tl.X - cx) * sinr + (tl.Y - cy) * cosr)
                                tr = _Vector2new(cx + (tr.X - cx) * cosr - (tr.Y - cy) * sinr, cy + (tr.X - cx) * sinr + (tr.Y - cy) * cosr)
                                br = _Vector2new(cx + (br.X - cx) * cosr - (br.Y - cy) * sinr, cy + (br.X - cx) * sinr + (br.Y - cy) * cosr)
                                bl = _Vector2new(cx + (bl.X - cx) * cosr - (bl.Y - cy) * sinr, cy + (bl.X - cx) * sinr + (bl.Y - cy) * cosr)
                        end

                        if settings.box then
                                local box_col = (vis_state_cache == true) and settings.box_visible_color or settings.box_color
                                setLineFrame(box_lines[1], tl, tr, box_col[1], 1)
                                setLineFrame(box_lines[2], tr, br, box_col[1], 1)
                                setLineFrame(box_lines[3], br, bl, box_col[1], 1)
                                setLineFrame(box_lines[4], bl, tl, box_col[1], 1)
                                for _, ln in pairs(box_lines) do
                                        ln.BackgroundTransparency = box_col[3]
                                end
                        else
                                for _, ln in pairs(box_lines) do ln.Visible = false end
                        end

                        if settings.box_outline then
                                local ocol = settings.box_outline_color
                                local otl, otr, obr, obl = rectCorners(tl, tr, br, bl, 2)
                                setLineFrame(outline_out[1], otl, otr, ocol[1], 1)
                                setLineFrame(outline_out[2], otr, obr, ocol[1], 1)
                                setLineFrame(outline_out[3], obr, obl, ocol[1], 1)
                                setLineFrame(outline_out[4], obl, otl, ocol[1], 1)
                                for _, ln in pairs(outline_out) do
                                        ln.BackgroundColor3 = ocol[1]
                                        ln.BackgroundTransparency = ocol[2]
                                end
                                local itl, itr, ibr, ibl = rectCorners(tl, tr, br, bl, -2)
                                setLineFrame(outline_in[1], itl, itr, ocol[3], 1)
                                setLineFrame(outline_in[2], itr, ibr, ocol[3], 1)
                                setLineFrame(outline_in[3], ibr, ibl, ocol[3], 1)
                                setLineFrame(outline_in[4], ibl, itl, ocol[3], 1)
                                for _, ln in pairs(outline_in) do
                                        ln.BackgroundColor3 = ocol[3]
                                        ln.BackgroundTransparency = ocol[4]
                                end
