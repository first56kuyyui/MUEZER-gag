                                        col_layout.SortOrder = Enum.SortOrder.LayoutOrder
                                        col_layout.Padding = UDim.new(0, 1)
                                        col_layout.Parent = col_frame
                                end

                                order = 0
                                local col_index, col_h = 1, 0
                                new_col(col_index)
                                for _, el in elements do
                                        if col_index < cols and col_h >= per_col * col_index - 0.5 then
                                                col_index += 1
                                                new_col(col_index)
                                        end
                                        order += 1
                                        col_h += el.h + 1
                                        if el.kind == "header" then
