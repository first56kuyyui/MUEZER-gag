                        )) * CFrame.Angles(0, ugViewYaw or lastYaw or 0, 0)
                        pcall(function()
                                r.AssemblyLinearVelocity = Vector3.zero
                                r.AssemblyAngularVelocity = Vector3.zero
                                r.CFrame = ugLastPose
                        end)
