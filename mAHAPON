                local ok = pcall(function()
                        RunService:BindToRenderStep(UGHideStepName, 2147483000, function()
                                if not active then
                                        return
                                end
                                local c = LocalPlayer.Character
                                for obj, saved in pairs(ugHiddenParts) do
                                        if obj.Parent then
