                        Utility.Signal(Objects.value.MouseButton1Click:Connect(function(input)
                                if Keybind.Listener then
                                        Keybind.CancelListening()

                                        if Library.PendingKeybind == Keybind then
                                                Library.PendingKeybind = nil
                                        end

                                        return
                                end

                                -- ถ้ามีช่องปุ่มอื่นรอตั้งค้างอยู่ ให้ยกเลิกตัวเก่าก่อน (ไม่ทิ้ง "[....]" ค้างหลายช่อง)
                                if Library.PendingKeybind and Library.PendingKeybind ~= Keybind then
                                        Library.PendingKeybind.CancelListening()
                                        Library.PendingKeybind = nil
                                end

                                Library.PendingKeybind = Keybind

                                Objects.value.Text = string.format("[%s]", "...")

                                Library.ChangeObjectTheme(Objects.value, {
                                        TextColor3 = "text"
                                }, true)

                                task.wait( 1/50 )

