    local QUEST_BLOCKLIST = {
        Activate = true, Complete = true, Claim = true, Reward = true, Rewards = true,
        HandIn = true, TurnIn = true, Submit = true, Finish = true, Collect = true, Redeem = true,
        Accept = true, Quest = true, Quests = true, Mission = true, Missions = true,
        Task = true, Tasks = true, Daily = true, Weekly = true, Objective = true,
        Bounty = true, Info = true, Data = true, Main = true, Game = true, Name = true,
        Value = true, State = true, Status = true, Type = true, Action = true, Prompt = true,
        QuestId = true, QuestID = true, QuestName = true, TaskId = true, TaskID = true,
        MissionId = true, MissionID = true, ActionText = true, ObjectText = true,
        Player = true, Players = true, Character = true, Humanoid = true, HumanoidRootPart = true,
        Workspace = true, ReplicatedStorage = true, LocalPlayer = true, Backpack = true,
        Client = true, Server = true, Remote = true, Remotes = true, Event = true, Events = true,
        Function = true, Button = true, Frame = true, Label = true, Template = true,
        Roblox = true, True = true, False = true, Nil = true, None = true,
    }

    local function nameIsQuesty(s)
        if type(s) ~= "string" or s == "" then return false end
        local lower = string.lower(s)
        return string.find(lower, "quest", 1, true) ~= nil
            or string.find(lower, "mission", 1, true) ~= nil
            or string.find(lower, "task", 1, true) ~= nil
            or string.find(lower, "daily", 1, true) ~= nil
            or string.find(lower, "weekly", 1, true) ~= nil
            or string.find(lower, "objective", 1, true) ~= nil
            or string.find(lower, "bounty", 1, true) ~= nil
            or string.find(lower, "boss", 1, true) ~= nil
            or string.find(lower, "raid", 1, true) ~= nil
    end

    local function countUpper(s)
        local n = 0
        for _ in string.gmatch(s, "%u") do n = n + 1 end
        return n
    end

    -- เทียบ prefix กับ quest ID ที่รู้จักแล้ว ช่วยจับภาคต่อ เช่น LeakingTunnelsPt1 -> Pt2
    local function sharesKnownPrefix(s)
        local function checkSet(set)
            if not set then return false end
            for id in pairs(set) do
                local minlen = math.min(#id, #s)
                if minlen >= 5 then
                    local same = 0
                    for i = 1, minlen do
                        if string.sub(id, i, i) == string.sub(s, i, i) then
                            same = same + 1
                        else
                            break
                        end
                    end
                    if same >= 5 and same >= minlen - 2 then return true end
                end
            end
            return false
        end
        if checkSet(QuestSystem.quest_ids) then return true end
        if checkSet(QuestSystem.discovered_ids) then return true end
        return false
    end

    -- เงื่อนไขหลวม (ใช้กับข้อมูลที่ context เป็นเควสอยู่แล้ว เช่น ในกล่อง Quests)
    local function looksLikeQuestIdLoose(s)
        if type(s) ~= "string" then return false end
        local len = #s
        if len < 4 or len > 60 then return false end
        if not string.match(s, "^%u[%w_]+$") then return false end
        if QUEST_BLOCKLIST[s] then return false end
        if not string.find(s, "%l") then return false end
        return true
    end

    -- เงื่อนไขเข้ม (ใช้กับ string ทั่วไปใน remote payload กันจับของแปลกปลอม)
    local function looksLikeQuestId(s)
        if not looksLikeQuestIdLoose(s) then return false end
        if string.find(s, "%d") then return true end
        if countUpper(s) >= 2 then return true end
        if sharesKnownPrefix(s) then return true end
        return false
    end

    local function anyStringMentionsQuest(t, depth)
        if depth > 3 or type(t) ~= "table" then return false end
        local n = 0
        for _, v in pairs(t) do
            n = n + 1
            if n > 40 then break end
            local tv = type(v)
            if tv == "string" then
                if nameIsQuesty(v) then return true end
            elseif tv == "table" then
                if anyStringMentionsQuest(v, depth + 1) then return true end
            end
        end
        return false
    end

    -- เก็บ string ที่หน้าตาเหมือน quest ID จาก payload (ไล่ตารางซ้อนได้)
    local function harvestStrings(t, out, loose, depth)
        if depth > 4 or type(t) ~= "table" then return end
        local n = 0
        for k, v in pairs(t) do
            n = n + 1
            if n > 60 then break end
            if type(k) == "string" and looksLikeQuestId(k) then
                out[k] = true
            end
            local tv = type(v)
            if tv == "string" then
                if (loose and looksLikeQuestIdLoose(v)) or looksLikeQuestId(v) then
                    out[v] = true
                end
            elseif tv == "table" then
                harvestStrings(v, out, loose or anyStringMentionsQuest(v, 0), depth + 1)
            end
        end
    end

    local function discoverQuestId(id, source)
        if type(id) ~= "string" or id == "" then return false end
        if QuestSystem.quest_ids[id] or QuestSystem.discovered_ids[id] then return false end
        local n = 0
        for _ in pairs(QuestSystem.discovered_ids) do n = n + 1 end
        if n >= MAX_DISCOVERED then return false end
        QuestSystem.discovered_ids[id] = true
        addLog("พบเควสใหม่ (" .. tostring(source) .. "): " .. id)
        if tick() - last_discover_notify > 5 then
            last_discover_notify = tick()
            if Library and Library.Notification then
                pcall(function() Library.Notification("พบเควสใหม่: " .. id, 4) end)
            end
        end
        -- เปิด Auto Accept อยู่ -> รับเควสใหม่ทันที ไม่ต้องรอรอบถัดไป
        if QuestSystem.enabled_accept and QuestSystem.discovery_enabled then
            task.spawn(function()
                task.wait(0.2)
                fireQuestUpdate(ACTION_ACCEPT, id)
            end)
        end
        return true
    end

    -- ให้ระบบ spy (Cobalt style) เรียกใช้ได้: เรียนรู้ quest ID จาก call ที่ spy ดักได้
    QuestSystem.spyLearnFromArgs = function(remoteName, args)
        if not QuestSystem.discovery_enabled then return end
        if not nameIsQuesty(remoteName) then return end
        local found = {}
        harvestStrings(args, found, true, 0)
        for id in pairs(found) do
            discoverQuestId(id, "spy:" .. tostring(remoteName))
        end
    end

    local function attachQuestListener(remote)
        if not remote or listened_remotes[remote] then return end
        local ok_cls, cn = pcall(function() return remote.ClassName end)
        if not ok_cls or (cn ~= "RemoteEvent" and cn ~= "UnreliableRemoteEvent" and cn ~= "RemoteFunction") then return end
        -- [Quest chain fix] เซิร์ฟอาจยิงสถานะเควสเข้าผ่าน RemoteFunction (OnClientInvoke) - เดิมไม่ดักเลย
        if cn == "RemoteFunction" then
            if listened_remotes[remote] then return end
            listened_remotes[remote] = true
            local rf_name = "?"
            pcall(function() rf_name = remote.Name end)
            local ok_wrap = pcall(function()
                local current_invoke = remote.OnClientInvoke
                if typeof(current_invoke) == "function" then
                    remote.OnClientInvoke = function(...)
                        local invoke_args = { ... }
                        pcall(function()
                            if not QuestSystem.discovery_enabled then return end
                            if #invoke_args == 0 then return end
                            local found = {}
                            harvestStrings(invoke_args, found, false, 0)
                            for id in pairs(found) do
                                discoverQuestId(id, rf_name .. ":Invoke")
                            end
                        end)
                        return current_invoke(...)
                    end
                end
            end)
            if not ok_wrap then
                listened_remotes[remote] = nil
            end
            return
        end
        listened_remotes[remote] = true
        local rname = "?"
        pcall(function() rname = remote.Name end)
        local questy = nameIsQuesty(rname)
        local ok_conn = pcall(function()
            remote.OnClientEvent:Connect(function(...)
                if not QuestSystem.discovery_enabled then return end
                if not (QuestSystem.enabled_accept or QuestSystem.enabled_complete
                    or QuestSystem.enabled_claim or QuestSystem.enabled_reward
                    or QuestSystem.enabled_extra or QuestSystem.enabled_send) then return end
                local args = {...}
                if #args == 0 then return end
                local found = {}
                harvestStrings(args, found, questy, 0)
                for id in pairs(found) do
                    discoverQuestId(id, rname)
                end
            end)
        end)
        if not ok_conn then
            listened_remotes[remote] = nil
        end
    end

    local function maybeAddContainer(inst)
        if not inst then return end
        local ok_n, cname = pcall(function() return inst.Name end)
        if not ok_n or not cname or not nameIsQuesty(cname) then return end
        local player = Players.LocalPlayer
        if player then
            local pg = player:FindFirstChild("PlayerGui")
            if pg and inst:IsDescendantOf(pg) then return end
        end
        quest_containers[inst] = true
    end

    -- หากล่องเก็บเควสครั้งแรก (ใต้ player กับ ReplicatedStorage)
    local function collectQuestContainers()
        local roots = {}
        local player = Players.LocalPlayer
        if player then roots[#roots + 1] = player end
        roots[#roots + 1] = ReplicatedStorage

        local skip = {}
        if player then
            local pg = player:FindFirstChild("PlayerGui")
            if pg then skip[pg] = true end
            local ch = player.Character
            if ch then skip[ch] = true end
        end

        local function rec(inst, depth)
            if depth > 5 then return end
            local ok_kids, kids = pcall(function() return inst:GetChildren() end)
            if not ok_kids or not kids then return end
            for _, child in ipairs(kids) do
                if not skip[child] then
                    maybeAddContainer(child)
                    rec(child, depth + 1)
                end
            end
        end

        for _, root in ipairs(roots) do
            rec(root, 0)
        end
    end

    -- สแกนของในกล่องเควส หา quest ID ที่ยังไม่รู้จัก
    local function scanContainerContents()
        for container in pairs(quest_containers) do
            if not container.Parent then
                quest_containers[container] = nil
            else
                local ok_desc, desc = pcall(function() return container:GetDescendants() end)
                if ok_desc and desc and #desc <= 400 then
                    for _, d in ipairs(desc) do
                        local ok_n, dname = pcall(function() return d.Name end)
                        if ok_n and looksLikeQuestIdLoose(dname) then
                            discoverQuestId(dname, "ข้อมูลเกม")
                        end
                        local ok_cls, dcls = pcall(function() return d.ClassName end)
                        if ok_cls and (dcls == "StringValue" or dcls == "ObjectValue") then
                            local ok_v, dval = pcall(function() return d.Value end)
                            if ok_v and type(dval) == "string" and looksLikeQuestIdLoose(dval) then
                                discoverQuestId(dval, "ข้อมูลเกม")
                            end
                        end
                    end
                end
            end
        end
    end

    -- ผูก listener กับ remote ที่มีอยู่แล้ว + ที่เกิดใหม่ตอนเข้าแมพ
    task.spawn(function()
        task.wait(2)
        local ok_desc, desc = pcall(function() return ReplicatedStorage:GetDescendants() end)
        if ok_desc and desc then
            for _, d in ipairs(desc) do
                attachQuestListener(d)
            end
        end
        -- [Quest chain fix] เดิมผูกดักเฉพาะ ReplicatedStorage - remote ใน Workspace/ตัว player ก็ดักด้วย
        local ok_ws, ws_desc = pcall(function() return Workspace:GetDescendants() end)
        if ok_ws and ws_desc and #ws_desc <= 8000 then
            for _, d in ipairs(ws_desc) do
                attachQuestListener(d)
            end
        end
        local lp = Players.LocalPlayer
        if lp then
            local pg = lp:FindFirstChild("PlayerGui")
            local ch = lp.Character
            local ok_kids, kids = pcall(function() return lp:GetDescendants() end)
            if ok_kids and kids then
                for _, d in ipairs(kids) do
                    if (not pg or not d:IsDescendantOf(pg)) and (not ch or not d:IsDescendantOf(ch)) then
                        attachQuestListener(d)
                    end
                end
            end
        end
    end)

    pcall(function()
        ReplicatedStorage.DescendantAdded:Connect(function(inst)
            task.spawn(attachQuestListener, inst)
            maybeAddContainer(inst)
        end)
    end)

    pcall(function()
        local player = Players.LocalPlayer
        if player then
            player.ChildAdded:Connect(function(inst)
                containers_dirty = true
                maybeAddContainer(inst)
            end)
        end
    end)

    -- เก็บกล่องเควสครั้งแรก + เก็บใหม่เมื่อมีของเกิดใหม่ (สแกนทุก 5 วิ เมื่อเปิดฟีเจอร์ quest ไว้)
    task.spawn(function()
        task.wait(4)
        last_collect_time = tick()
        pcall(collectQuestContainers)
    end)

    task.spawn(function()
        while true do
            task.wait(5)
            if QuestSystem.discovery_enabled
            and (QuestSystem.enabled_accept or QuestSystem.enabled_complete
                or QuestSystem.enabled_claim or QuestSystem.enabled_reward
                or QuestSystem.enabled_extra or QuestSystem.enabled_send) then
                if containers_dirty and tick() - last_collect_time > 10 then
                    containers_dirty = false
                    last_collect_time = tick()
                    pcall(collectQuestContainers)
                end
                pcall(scanContainerContents)
            end
        end
    end)

    -- ให้ hook (ระบบ SPY) เช็คชื่อ remote ว่าใช่เควส/บอสไหมได้จากภายนอก block นี้
    QuestSystem.nameIsQuesty = nameIsQuesty

    -- [Quest chain fix] ให้ส่วนอื่น (ป้าย prompt) เรียนรู้ quest ID จากข้อความได้
    -- ใช้เงื่อนไขเข้มกันจับขยะ (มีตัวเลข/ตัวใหญ่ 2 ตัวขึ้นไป/prefix เดียวกับเควสที่รู้จักเท่านั้น)
    QuestSystem.learnFromText = function(s, source)
        if not QuestSystem.discovery_enabled then return end
        if looksLikeQuestId(s) then
            discoverQuestId(s, source)
        end
    end

    -- ═══ ดัก call จริงแล้วยิงกลับ (Auto Send - learn & replay แบบ Cobalt) ═══
    -- อาการที่แก้: รับเควสได้ทุกตัวแต่ไม่ "ส่ง" เควสให้ + เควสบอสไม่ถูกยิงรับ
    -- เหตุผล: action ตอนส่งเควส/รับเควสบอสเป็นค่าเดา (Complete/Claim) ไม่ใช่ค่าจริงของเกม
    -- วิธีนี้: hook ดัก call จริงของเกม (remote+method+args ครบทุกตัว) ทุกครั้งที่เกมยิงออก
    -- พอเกม/เราทำเควสบอสหรือส่งเควสจริงครั้งเดียว ระบบจำแล้วยิงกลับเองทุกรอบให้ครบทุก quest ID
    local learned_keys = {}
    local MAX_LEARNED_CALLS = 12
    local ACTION_HINTS = {
        "activ", "accept", "complet", "claim", "reward", "submit", "hand", "turn",
        "finish", "collect", "redeem", "start", "begin", "take", "deliver",
        "progress", "update", "done", "kill", "defeat", "boss", "raid", "quest",
    }

    local function actionLooksReal(s)
        if type(s) ~= "string" then return false end
        local len = #s
        if len < 3 or len > 28 then return false end
        if string.find(s, " ", 1, true) then return false end
        if not string.match(s, "^%a[%w_]*$") then return false end
        local lower = string.lower(s)
        for _, hint in ipairs(ACTION_HINTS) do
            if string.find(lower, hint, 1, true) then return true end
        end
        return false
    end

    local function findQuestSlot(args)
        for i = 1, #args do
            local v = args[i]
            if type(v) == "string" and #v <= 60
            and (QuestSystem.quest_ids[v] or QuestSystem.discovered_ids[v]) then
                return i
            end
        end
        return nil
    end

    -- hook เรียกเสมอเมื่อเกมยิง FireServer/InvokeServer ออกไปที่ remote ชื่อเกี่ยวกับเควส/บอส
    QuestSystem.learnQuestCall = function(remote, method, args)
        if not QuestSystem.enabled_send then return end
        if QuestSystem._self_fire_until and os.clock() < QuestSystem._self_fire_until then return end
        if type(args) ~= "table" or #args == 0 or #args > 10 then return end
        local name = "?"
        pcall(function() name = remote.Name end)
        if not nameIsQuesty(name) then return end
        local action = nil
        for i = 1, #args do
            local v = args[i]
            if type(v) == "string" and actionLooksReal(v) then
                action = v
                break
            end
        end
        if not action then return end
        local snap = {}
        for i = 1, #args do snap[i] = args[i] end
        -- [Quest chain fix] เรียนรู้ quest ID ตัวใหม่จาก call จริงของเกมด้วย (เดิมเรียนเฉพาะตอนเปิด Spy Record)
        -- เกมยิง call เควสภาคต่อออกเองเมื่อไหร่ จะได้จำ ID ใหม่แล้วรับให้เองต่อเนื่องทันที
        if QuestSystem.spyLearnFromArgs then
            pcall(QuestSystem.spyLearnFromArgs, name, snap)
        end
        local key = name .. "|" .. tostring(method) .. "|" .. action
        for _, tpl in ipairs(QuestSystem.learned_calls) do
            if tpl.key == key then
                tpl.args = snap
                local slot2 = findQuestSlot(snap)
                if slot2 then tpl.slot = slot2 end
                return
            end
        end
        if #QuestSystem.learned_calls >= MAX_LEARNED_CALLS then return end
        local tpl2 = {
            key = key, remote = remote, name = name, method = tostring(method),
            action = action, slot = findQuestSlot(snap), args = snap,
        }
        table.insert(QuestSystem.learned_calls, tpl2)
        addLog(string.format("ดัก call จริงได้: %s.%s(%s) - ระบบจะยิงกลับเองทุกรอบ", name, tpl2.method, action))
        if Library and Library.Notification then
            pcall(function() Library.Notification("ดัก call เควสจริงได้: " .. name .. " (" .. action .. ")", 4) end)
        end
    end
end

-- ยิง call จริงที่ดักได้กลับไปทุกรอบ (Auto Send) - ทำซ้ำสิ่งที่เกมทำกับเควส เช่น ส่งเควส/รับเควสบอส
-- ถ้า call ที่ดักได้มี quest ID ใน args จะเปลี่ยนเป็นทุก ID ที่รู้จักแล้วยิงครบ ถ้าไม่มีก็ยิงตรงตามที่ดักได้
local function replayLearnedQuestCalls()
    if not QuestSystem.enabled_send then return 0 end
    local fired = 0
    for _, tpl in ipairs(QuestSystem.learned_calls) do
        if fired >= 40 then break end
        local remote = tpl.remote
        if remote and remote.Parent then
            local ids = nil
            if tpl.slot then
                ids = {}
                for id in pairs(QuestSystem.quest_ids) do ids[#ids + 1] = id end
                for id in pairs(QuestSystem.discovered_ids) do ids[#ids + 1] = id end
                if QuestSystem.custom_quest_id and QuestSystem.custom_quest_id ~= "" then
                    ids[#ids + 1] = QuestSystem.custom_quest_id
                end
            end
            if ids and #ids > 0 then
                for _, id in ipairs(ids) do
                    if fired >= 40 then break end
                    local args = {}
                    for i = 1, #tpl.args do args[i] = tpl.args[i] end
                    args[tpl.slot] = id
                    QuestSystem._self_fire_until = os.clock() + 0.1
                    if tpl.method == "FireServer" then
                        pcall(function() remote:FireServer(unpack(args)) end)
                    else
                        pcall(function() remote:InvokeServer(unpack(args)) end)
                    end
                    fired = fired + 1
                    task.wait(0.05)
                end
            else
                QuestSystem._self_fire_until = os.clock() + 0.1
                if tpl.method == "FireServer" then
                    pcall(function() remote:FireServer(unpack(tpl.args)) end)
                else
                    pcall(function() remote:InvokeServer(unpack(tpl.args)) end)
                end
                fired = fired + 1
                task.wait(0.05)
            end
        end
    end
    return fired
end

-- ═══════════ ระบบ SPY (Cobalt style) ═══════════
-- โครงสร้างดักค่าแบบ Cobalt: ดักได้ "ค่า argument จริง" ทุกตัว ไม่ใช่แค่จำนวน args
--   OUT (เกมยิงออก): FireServer / InvokeServer ผ่าน hook __namecall
--                     + ดักผลลัพธ์ที่เซิร์ฟตอบกลับของ InvokeServer ด้วย
--   IN  (เซิร์ฟยิงเข้า): OnClientEvent ของทุก remote ที่หาเจอ (ReplicatedStorage/ตัวละคร/Workspace)
--                     + OnClientInvoke แบบ wrap ต่อท้าย callback เดิมของเกม (เกมยังทำงานปกติ)
--   + เรียนรู้ quest ID ใหม่จากทุก call ที่ดักได้ (ส่งต่อให้ระบบดักเควสใหม่)
--   + ปุ่มเซฟ log ลงไฟล์ได้เหมือน Cobalt (Cobalt/Logs)
do
    local function getRemotePath(remote)
        if not remote then return "?" end
        local path = {}
        local cur = remote
        for _ = 1, 6 do
            if not cur or cur == game then break end
            local ok_n, n = pcall(function() return cur.Name end)
            if not ok_n then break end
            table.insert(path, 1, n)
            cur = cur.Parent
        end
        return table.concat(path, ".")
    end

    local function safeGetClass(inst)
        if not inst then return nil end
        local ok, cn = pcall(function() return inst.ClassName end)
        return ok and cn or nil
    end

    -- เก็บ args แค่ 10 ตัวแรก (กัน payload ยักษ์)
    local function capSpyArgs(args)
        local safeArgs = {}
        local n = math.min(#args, 10)
        for i = 1, n do
            safeArgs[i] = args[i]
        end
        return safeArgs
    end

    -- แปลงค่าเป็นข้อความอ่านง่าย (string/number/bool/Instance/table ไล่ซ้อน 2 ชั้น)
    local function spyValueToString(v, depth)
        depth = depth or 0
        local tv = typeof(v)
        if tv == "string" then
            local s = v
            if #s > 120 then s = string.sub(s, 1, 120) .. "..." end
            return '"' .. s .. '"'
        elseif tv == "number" or tv == "boolean" then
            return tostring(v)
        elseif tv == "nil" then
            return "nil"
        elseif tv == "Instance" then
            local ok_n, name = pcall(function() return v.Name end)
            local ok_c, cn = pcall(function() return v.ClassName end)
            return tostring(cn or "?") .. "(" .. tostring(name or "?") .. ")"
        elseif tv == "table" then
            if depth >= 2 then return "{...}" end
            local parts = {}
            local count = 0
            for k, val in pairs(v) do
                count = count + 1
                if count > 8 then
                    table.insert(parts, "...")
                    break
                end
                local key_text
                if type(k) == "string" then
                    key_text = k .. " = "
                else
                    key_text = "[" .. spyValueToString(k, depth + 1) .. "] = "
                end
                table.insert(parts, key_text .. spyValueToString(val, depth + 1))
            end
            return "{" .. table.concat(parts, ", ") .. "}"
        elseif tv == "function" then
            return "<closure>"
        else
            local ok_t, text = pcall(tostring, v)
            if not ok_t or text == nil then return tostring(tv) end
            if #text > 120 then text = string.sub(text, 1, 120) .. "..." end
            return tostring(tv) .. ":" .. text
        end
    end

    local function spyArgsToString(args)
        local parts = {}
        for i = 1, #(args or {}) do
            table.insert(parts, spyValueToString(args[i], 0))
        end
        local text = "(" .. table.concat(parts, ", ") .. ")"
        if #text > 400 then
            text = string.sub(text, 1, 400) .. "..."
        end
        return text
    end

    local function recordSpyCall(direction, remote, method, args, packedResult)
        if not QuestSystem.spy_recording then return end
        if not remote then return end
        local cn = safeGetClass(remote)
        if cn ~= "RemoteEvent" and cn ~= "RemoteFunction" and cn ~= "UnreliableRemoteEvent"
            and cn ~= "BindableEvent" and cn ~= "BindableFunction" then
            return
        end
        local name = "?"
        pcall(function() name = remote.Name end)
        local path = getRemotePath(remote)
        local entry = {
            remote = remote,
            name = name,
            path = path,
            class = cn,
            method = method,
            args = args,
            direction = direction,
            time = tick(),
        }
        if type(packedResult) == "table" and (packedResult.n or 0) > 0 then
            entry.result = packedResult[1]
            entry.result_count = packedResult.n
        end
        table.insert(QuestSystem.recorded_remotes, entry)
        if #QuestSystem.recorded_remotes > 200 then
            table.remove(QuestSystem.recorded_remotes, 1)
        end
        local line = "SPY" .. direction .. " " .. path .. "." .. method .. spyArgsToString(args)
        if entry.result ~= nil then
            line = line .. " -> " .. spyValueToString(entry.result, 0)
            if (entry.result_count or 0) > 1 then
                line = line .. " (+" .. (entry.result_count - 1) .. " more)"
            end
        end
        if #line > 400 then
            line = string.sub(line, 1, 400) .. "..."
        end
        addLog(line)
        -- ส่งต่อให้ระบบดักเควสใหม่เรียนรู้ quest ID จาก call นี้ (ทั้งเข้าและออก)
        if QuestSystem.spyLearnFromArgs then
            pcall(QuestSystem.spyLearnFromArgs, name, args)
        end
    end

    -- ─── OUT: hook __namecall จับ FireServer / InvokeServer (แบบเดียวกับ Cobalt) ───
    local __namecall
    local ok_hook, err_hook = pcall(function()
        __namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                local cn = safeGetClass(self)
                if cn == "RemoteEvent" or cn == "RemoteFunction" or cn == "UnreliableRemoteEvent" then
                    -- [Auto Send] ดัก call จริงของเกมที่เป็นเควส/บอสทุกครั้ง (ไม่ต้องเปิด Spy Record)
                    -- เจอ remote ชื่อเกี่ยวกับเควส/บอส > เรียนรู้ action/args จริงไว้ยิงกลับให้เควสทุกตัว
                    if QuestSystem.enabled_send and QuestSystem.nameIsQuesty and QuestSystem.learnQuestCall then
                        local ok_ln, rname = pcall(function() return self.Name end)
                        if ok_ln and QuestSystem.nameIsQuesty(rname) then
                            task.spawn(pcall, QuestSystem.learnQuestCall, self, method, { ... })
                        end
                    end
                    if QuestSystem.spy_recording then
                        local args = capSpyArgs({...})
                        if method == "InvokeServer" then
                            -- ดักผลตอบของเซิร์ฟด้วย (แบบ Cobalt) แล้วส่งค่าเดิมกลับให้เกมครบทุกค่า
                            local packed = table.pack(__namecall(self, ...))
                            task.spawn(pcall, recordSpyCall, ">>", self, method, args, packed)
                            return table.unpack(packed, 1, packed.n)
                        end
                        task.spawn(pcall, recordSpyCall, ">>", self, method, args, nil)
                    end
                end
            end
            return __namecall(self, ...)
        end))
    end)
    if ok_hook then
        addLog("Spy hook installed")
    else
        addLog("Spy hook failed: " .. tostring(err_hook))
    end

    -- ─── IN: ดักของที่เซิร์ฟยิงเข้ามา (OnClientEvent) + OnClientInvoke ───
    local spy_in_listened = setmetatable({}, {__mode = "k"})
    local spy_invoke_wrapped = setmetatable({}, {__mode = "k"})

    local function attachSpyInListener(remote)
        if not remote then return end
        local ok_cls, cn = pcall(function() return remote.ClassName end)
        if not ok_cls then return end
        if cn == "RemoteEvent" or cn == "UnreliableRemoteEvent" then
            if spy_in_listened[remote] then return end
            spy_in_listened[remote] = true
            local ok_conn = pcall(function()
                remote.OnClientEvent:Connect(function(...)
                    if not QuestSystem.spy_recording or not QuestSystem.spy_in_enabled then return end
                    local args = capSpyArgs({...})
                    task.spawn(pcall, recordSpyCall, "<<", remote, "OnClientEvent", args, nil)
                end)
            end)
            if not ok_conn then
                spy_in_listened[remote] = nil
            end
        elseif cn == "RemoteFunction" then
            if spy_invoke_wrapped[remote] then return end
            spy_invoke_wrapped[remote] = true
            pcall(function()
                local current = remote.OnClientInvoke
                if typeof(current) == "function" then
                    remote.OnClientInvoke = function(...)
                        if QuestSystem.spy_recording and QuestSystem.spy_in_enabled then
                            local args = capSpyArgs({...})
                            task.spawn(pcall, recordSpyCall, "<<", remote, "OnClientInvoke", args, nil)
                        end
                        return current(...)
                    end
                end
            end)
        end
    end

    local function scanRemotesForSpy()
        local ok_desc, desc = pcall(function() return ReplicatedStorage:GetDescendants() end)
        if ok_desc and desc then
            for _, d in ipairs(desc) do
                attachSpyInListener(d)
            end
        end
        local player = Players.LocalPlayer
        if player then
            local pg = player:FindFirstChild("PlayerGui")
            local ch = player.Character
            local ok_kids, kids = pcall(function() return player:GetDescendants() end)
            if ok_kids and kids then
                for _, d in ipairs(kids) do
                    if (not pg or not d:IsDescendantOf(pg)) and (not ch or not d:IsDescendantOf(ch)) then
                        attachSpyInListener(d)
                    end
                end
            end
        end
        local ok_ws, ws_desc = pcall(function() return Workspace:GetDescendants() end)
        if ok_ws and ws_desc and #ws_desc <= 8000 then
            for _, d in ipairs(ws_desc) do
                attachSpyInListener(d)
            end
        end
    end

    -- ผูก listener ครั้งแรก + ตาม remote ที่เกิดใหม่ + วนเช็คซ้ำตอน spy เปิดอยู่
    task.spawn(function()
        task.wait(2)
        pcall(scanRemotesForSpy)
    end)

    pcall(function()
        ReplicatedStorage.DescendantAdded:Connect(function(inst)
            task.spawn(attachSpyInListener, inst)
        end)
    end)

    pcall(function()
        local player = Players.LocalPlayer
        if player then
            player.DescendantAdded:Connect(function(inst)
                local pg = player:FindFirstChild("PlayerGui")
                if pg and inst:IsDescendantOf(pg) then return end
                task.spawn(attachSpyInListener, inst)
            end)
        end
    end)

    task.spawn(function()
        while true do
            task.wait(10)
            if QuestSystem.spy_recording then
                pcall(scanRemotesForSpy)
            end
        end
    end)

    -- ─── เซฟ log ลงไฟล์แบบ Cobalt ───
    local function saveSpyLogToFile()
        if type(writefile) ~= "function" then
            addLog("Save log: executor นี้ไม่มี writefile")
            return
        end
        pcall(function() makefolder("Cobalt") end)
        pcall(function() makefolder("Cobalt/Logs") end)
        local stamp = os.date("%Y-%m-%d_%H-%M-%S")
        local file_name = "Cobalt/Logs/muzerhub_spy_" .. stamp .. ".log"
        local parts = {}
        for i = #QuestSystem.recorded_remotes, 1, -1 do
            local rec = QuestSystem.recorded_remotes[i]
            local line = string.format("[%s] %s %s.%s%s",
                os.date("%H:%M:%S", rec.time or tick()),
                rec.direction or ">>",
                rec.path or "?",
                rec.method or "?",
                spyArgsToString(rec.args or {}))
            if rec.result ~= nil then
                line = line .. " -> " .. spyValueToString(rec.result, 0)
            end
            table.insert(parts, line)
        end
        local ok_w = pcall(function()
            writefile(file_name, table.concat(parts, "\n") .. "\n")
        end)
        if ok_w then
            addLog("เซฟ spy log แล้ว (" .. #parts .. " calls): " .. file_name)
            if Library and Library.Notification then
                pcall(function() Library.Notification("เซฟ spy log แล้ว: " .. file_name, 5) end)
            end
        else
            addLog("เซฟ spy log ไม่สำเร็จ")
        end
    end
    QuestSystem.saveSpyLogToFile = saveSpyLogToFile
end

-- ยิง remote ที่บันทึกไว้ซ้ำ (replay)
local function replayRecorded()
    local count = 0
    for _, rec in ipairs(QuestSystem.recorded_remotes) do
        if rec.remote and rec.remote.Parent then
            local args = rec.args or {}
            local ok
            if rec.method == "FireServer" then
                ok = pcall(function() rec.remote:FireServer(unpack(args)) end)
            elseif rec.method == "InvokeServer" then
                ok = pcall(function() rec.remote:InvokeServer(unpack(args)) end)
            end
            if ok then count = count + 1 end
        end
    end
    return count
end

