        cheat.DrawingImpl = (function()
                -- [Real fix v2] รอบก่อนเช็คแค่ว่า "สร้าง Drawing ได้" แต่ REAL สร้างได้โดยที่
                -- ตั้งค่า property ไม่ได้ / วาดไม่ขึ้นจริง ทำให้ init ของสคริปต์พังกลางทาง
