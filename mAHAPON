                                end
                                local amount = tonumber(tip.amount) or (inst and tonumber(inst:GetAttribute("Amount")))
                                if amount and amount > 1 then
                                        lines[#lines + 1] = "Amount: " .. tip_comma(amount) .. "x"
                                end
                                local dur, max_dur = inst and inst:GetAttribute("Durability"), inst and inst:GetAttribute("MaxDurability")
                                if dur and max_dur and max_dur > 0 then
                                        lines[#lines + 1] = ("Durability: %d%% (%d/%d)"):format(mathfloor(dur / max_dur * 100 + 0.5), mathfloor(dur), mathfloor(max_dur))
                                end
                                local ammo = tip.ammo or (inst and inst:GetAttribute("LoadedAmmo"))
                                if ammo and ammo > 0 then
                                        lines[#lines + 1] = "Ammo: " .. tostring(ammo)
                                end
                                local id = inst and (inst:GetAttribute("ID") or inst:GetAttribute("ItemID") or inst:GetAttribute("ItemId"))
                                if id then
                                        lines[#lines + 1] = "ID: " .. tostring(id)
                                end
                                local attachments = inst and inst:FindFirstChild("Attachments")
                                if attachments then
                                        local first = true
                                        for _, attachment in attachments:GetChildren() do
                                                if first then
                                                        lines[#lines + 1] = ""
                                                        lines[#lines + 1] = "Attachments:"
                                                        first = false
                                                end
                                                local text = "  + " .. tip_escape(tip_base_name(attachment.Name))
                                                local a_ammo = attachment:GetAttribute("LoadedAmmo")
                                                local a_dur, a_max = attachment:GetAttribute("Durability"), attachment:GetAttribute("MaxDurability")
                                                local extra = {}
                                                if a_ammo and a_ammo > 0 then extra[#extra + 1] = tostring(a_ammo) .. " ammo" end
                                                if a_dur and a_max and a_max > 0 then extra[#extra + 1] = tostring(mathfloor(a_dur / a_max * 100 + 0.5)) .. "%" end
                                                if #extra > 0 then text ..= " (" .. table.concat(extra, ", ") .. ")" end
                                                lines[#lines + 1] = text
                                        end
                                end
                                if tip.subs then
                                        lines[#lines + 1] = ""
                                        lines[#lines + 1] = "Contents:"
                                        for sub_name, sub_amount in tip.subs do
                                                lines[#lines + 1] = "  - " .. tip_escape(tip_base_name(sub_name)) .. " x" .. tostring(sub_amount)
                                        end
                                end
                                return table.concat(lines, "\n")
                        end
                        local function show_tooltip(row, tip)
