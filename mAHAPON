        end

        local UpdateUnderground
        UpdateUnderground = function(deltaTime)
                if typeof(deltaTime) ~= "number" or deltaTime ~= deltaTime or deltaTime <= 0 then
                        deltaTime = 0.016
                elseif deltaTime > 0.1 then
                        deltaTime = 0.1
                end

                if not (cheat.ug_state and cheat.ug_state.on) then
                        if active and not ugRising then
                                -- ★ v49: ปิดมุด = ไต่ขึ้นผิวทีละเฟรม (ไม่ teleport ไม่ anchor)
                                --   teleport +4.6 ในเฟรมเดียว + velocity=0 = anti-cheat จับเป็น teleport
                                --   → เซิร์ฟดึงกลับจุดใต้ดิน (ในพื้น) → guard สู้ 1.2s (ยืนค้าง) → หมด guard ตัวในพื้น → ตกโลก
                                --   ไต่ทีละนิด un-anchored + velocity ตรง movement = เซิร์ฟรับตำแหน่งขึ้นปกติ ไม่จับ ไม่ตก
                                --   (depth 0.9 ทำให้เซิร์ฟรับตำแหน่งใต้ดินอยู่แล้ว = ไต่ขึ้น replicate สะอาด)
                                if not ugStartRise() then
                                        stopUnderground()
                                end
                        end
                        if not (active and ugRising) then
                                return
                        end
                elseif ugRising then
                        -- เปิดกลบมุดกลางคัน = ยกเลิกการไต่ขึ้น กลับไปจมต่อ
                        ugRising = false
                        ugRiseTargetY = nil
                end

                local char = LocalPlayer.Character
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
                if not char or not humanoid or not root or humanoid.Health <= 0 then
                        return
                end

                if char ~= lastChar then
                        if active then
                                stopUnderground()
                        end
                        lastChar = char
                        lastGroundY = nil
                        printedGround = false
                        collideSaved = nil
                end

                -- ★ v44 anti-rollback: เกมดึงตำแหน่งกลับ (rollback) = เกมไม่ยอมรับจุดเดิม
                --   รับตำแหน่งที่เกมย้ายให้ทันที ไม่สวนกลับ (เดิม re-assert สวน rollback ทุกเฟรม
                --   กลายเป็นตีลังกาสลับตำแหน่งไปมา = วาปมั่ว + ขาล็อค + FPS ตก)
                if ugServerSnapped then
                        ugServerSnapped = false
                        if not ugStealthAnchored and ugLastPose then
                                lastGroundY = nil
                                ugLastPose = nil
                                ugHoldUntil = 0
                                printedGround = false
                                print("[MUZER] Underground: เกมดึงตำแหน่งกลับ - ยอมรับจุดใหม่แล้วเล่นต่อ ไม่สวนกลับ")
                        end
                end

                if not active then
                        active = true
                        if ugExitGuardConn then
                                pcall(function()
                                        ugExitGuardConn:Disconnect()
                                end)
                                ugExitGuardConn = nil
                        end
                        savedHumanoid = humanoid
                        -- ★ UG speed sync: จับ WalkSpeed ต้นฉบับไว้ตอนเริ่มมุด (ตัวเดินคูณทุกเฟรมอิงค่านี้ และคืนค่านี้ตอนปิด)
                        ugBaseWalkSpeed = (humanoid.WalkSpeed and humanoid.WalkSpeed > 0.1) and humanoid.WalkSpeed or 16
                        ugWalkSynced = false
                        savedAutoRotate = humanoid.AutoRotate
                        savedCameraOffset = humanoid.CameraOffset
                        -- คำนวณ offset ความสูงกล้องจริงของริก (R6/R15) เก็บไว้ใช้ตลอดโหมด
                        local cameraHeight = 1.5
                        if humanoid.RigType == Enum.HumanoidRigType.R15 then
                                if humanoid.AutomaticScalingEnabled then
                                        cameraHeight = cameraHeight + (root.Size.Y - 2) / 2
                                else
                                        cameraHeight = 2
                                end
                        end
                        savedCameraHeightOffset = Vector3.new(0, cameraHeight, 0)
                        savedCameraWorldOffset = root.CFrame:VectorToWorldSpace(savedCameraHeightOffset + savedCameraOffset)
                        initialRootY = root.Position.Y
                        -- ★ Miko-faithful: ไม่ anchor ตอนเริ่มมุด - root เคลื่อนจริง replicate ไปเซิร์ฟ
                        --   ปกติ (เหมือน Miko Hub ต้นฉบับ) เซิร์ฟเห็นเดินใต้ดินตามจริง พอกดขึ้น ugStartRise
                        --   anchor ที่จุดปัจจุบัน(far) ก่อนโผล่ = jump เล็ก ไม่ดึงกลับจุดเริ่มมุด ไม่วาป 2-3วิ
                        --   (anchor เฉพาะช่วง hold ยิงล่องหน 0.45s + ช่วงไต่ขึ้น เท่านั้น - ดู SurfaceNow/ugStartRise)
                        ugServerAnchorPos = root.Position
                        ugStealthAnchored = false
                        pcall(function()
                                root.AssemblyLinearVelocity = Vector3.zero
                                root.AssemblyAngularVelocity = Vector3.zero
                        end)
                        local startCam = workspace.CurrentCamera
                        if startCam then
                                savedCameraY = startCam.CFrame.Position.Y
                                -- เริ่มมุมมองจากที่ผู้เล่นกำลังมองอยู่พอดี
                                local look = startCam.CFrame.LookVector
                                ugViewPitch = math.asin(math.clamp(look.Y, -1, 1))
                                ugViewYaw = math.atan2(-look.X, -look.Z)
                        end
                        ugEyeHeightY = nil
                        if ugInputConn then
                                ugInputConn:Disconnect()
                                ugInputConn = nil
                        end
                        -- เผื่อโหมดที่เกมไม่ล็อคเมาส์ (third person): หมุนด้วยคลิกขวาลาก
                        ugInputConn = ugTrackConnection(UserInputService.InputChanged:Connect(function(input)
                                if not active or not input then
                                        return
                                end
                                if input.UserInputType ~= Enum.UserInputType.MouseMovement then
                                        return
                                end
                                if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
                                        return
                                end
                                if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                                        return
                                end
                                local d = input.Delta
                                if d.X ~= 0 then
                                        ugViewYaw -= d.X * UG_MOUSE_SENS
                                end
                                if d.Y ~= 0 then
                                        ugViewPitch = math.clamp(
                                                ugViewPitch - d.Y * UG_MOUSE_SENS,
                                                math.rad(-85), math.rad(85)
                                        )
                                end
                        end))
                        pcall(function()
                                humanoid.AutoRotate = false
                        end)
                        -- re-assert pose ครบ 3 จุดของเฟรม: Stepped (ก่อน physics) + Heartbeat
                        -- (หลัง physics ก่อน server เก็บตำแหน่ง) — controller เกม register ก่อน = รันก่อน เราชนะท้ายเสมอ
                        if ugSteppedConn then
                                pcall(function()
                                        ugSteppedConn:Disconnect()
                                end)
                        end
                        if ugHeartbeatConn then
                                pcall(function()
                                        ugHeartbeatConn:Disconnect()
                                end)
                        end
                        ugApplyPose = function()
                                local c = LocalPlayer.Character
                                local h = c and c:FindFirstChildOfClass("Humanoid")
                                local r = c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
                                if not c or c ~= lastChar or not h or not r or h.Health <= 0 then
                                        return
                                end
                                if not (cheat.ug_state and cheat.ug_state.on) then
                                        return
                                end
                                -- ★ Miko-faithful: re-assert pose + velocity=ugLastVel ทุกเฟรม (Stepped+Heartbeat)
                                --   ไม่มี stealth shortcut ไม่มี ugServerSnapped (Miko ไม่ยอม rollback สวนทาง
                                --   re-assert ทุกเฟรม = ตัวอยู่ที่โพสที่เราเขียนเสมอ เซิร์ฟเห็นเดินตามจริง)
                                --   velocity=ugLastVel (ตรงการเคลื่อนไหว) = ไม่โดนเตะ speed/teleport
                                local ugCollideList = UGSyncCollideParts(c)
                                for _, part in ipairs(ugCollideList) do
                                        if part.Parent then
                                                if collideSaved[part] == nil then
                                                        collideSaved[part] = part.CanCollide
                                                end
                                                if part.CanCollide then
                                                        part.CanCollide = false
                                                end
                                                if ugHitSaved[part] == nil then
                                                        ugHitSaved[part] = { part.CanQuery, part.CanTouch }
                                                end
                                                if part.CanQuery then
                                                        part.CanQuery = false
                                                end
                                                if part.CanTouch then
                                                        part.CanTouch = false
                                                end
                                        end
                                end
                                pcall(function()
                                        if r.Parent then
                                                r.AssemblyLinearVelocity = ugLastVel
                                                r.AssemblyAngularVelocity = Vector3.zero
                                                if ugLastPose then
                                                        -- ช่วง hold = re-assert โพส "ยืน" เหนือผิวดิน
                                                        if tick() < ugHoldUntil and lastGroundY and savedRootHeight then
                                                                ugLastPose = CFrame.new(Vector3.new(
                                                                        r.Position.X,
                                                                        lastGroundY + savedRootHeight,
                                                                        r.Position.Z
                                                                )) * CFrame.Angles(0, ugViewYaw or lastYaw or 0, 0)
                                                        end
                                                        r.CFrame = ugLastPose
                                                end
                                        end
                                end)
                        end
                        collideSaved = collideSaved or {}
                        -- ★ v51 FPS: เอา Stepped ออก (ซ้ำ Heartbeat = ugApplyPose รัน 2x/เฟรม ทำ FPS ตก 80→40)
                        --   เก็บ Heartbeat อย่างเดียว (หลัง physics = จับ rollback ได้ดีพอ) re-assert 1x/เฟรมพอ
                        ugHeartbeatConn = ugTrackConnection(RunService.Heartbeat:Connect(ugApplyPose))
                        UGBindHideStep()
                        print("[MUZER] Underground ON")
                end

                -- ★ v51 FPS: throttle หาผิวดิน ทุก 0.1s (เดิม raycast 500 studs ทุกเฟรม = 60x/วิ หนักมาก)
                --   พื้นไม่เคลื่อนเร็ว 0.1s พอ lastGroundY ยังตามจริง ลด raycast 6x
                if tick() - ugProbeAt >= 0.1 then
                        ugProbeAt = tick()
                        ProbeGround(root)
                end
                if savedRootHeight == nil then
                        savedRootHeight = initialRootY - lastGroundY
                end
                -- ระดับตาเหนือผิวดิน = กล้องตอนเปิด − ผิวดินตอนเปิด (เก็บครั้งเดียว บวกผิวดินปัจจุบันทุกเฟรม
                -- เดินขึ้นเนิน/ลงเนิน กล้องลอยตามผิวดินเสมอ)
                if ugEyeHeightY == nil and lastGroundY then
                        if savedCameraY then
                                ugEyeHeightY = savedCameraY - lastGroundY
                        else
                                ugEyeHeightY = (initialRootY - lastGroundY) + 1.5
                        end
                        if ugEyeHeightY < 1 then
                                ugEyeHeightY = 1
                        end
                end

                if not printedGround and lastGroundY then
                        printedGround = true
                        print(string.format("[MUZER] Underground: ผิวดิน Y=%.1f", lastGroundY))
                end

                local depth = math.clamp(tonumber(cheat.ug_state.depth) or 0.9, 0.1, 0.9)  -- [v48] ล็อคลึกสูงสุด 0.9 ตาม Miko (ลึกกว่า 0.9 = anti-cheat ตรวจจับเป็น "ใต้ดิน" ปฏิเสธตำแหน่ง client → เซิร์ฟจำจุดลงไว้ → โผล่ที่ไกล ~3 วิแล้วดึงกลับจุดลง; 0.9 ตื้นพออยู่ใต้ threshold เซิร์ฟรับตำแหน่งปกติ = ไม่วาป)
                local targetY
                if ugRising then
                        targetY = ugRiseTargetY or root.Position.Y
                else
                        targetY = (lastGroundY or root.Position.Y) - depth
                end

                -- เดินด้วย MoveDirection (สัมพัทธ์กล้องอยู่แล้ว) + ย้ายตัวด้วย CFrame ทุกเฟรม
                local dir = humanoid.MoveDirection
                if typeof(dir) ~= "Vector3" then
                        dir = Vector3.zero
                end

                local speed = 16
                -- ★ UG speed sync: ใช้ WalkSpeed ต้นฉบับที่จับตอนเริ่มมุดเสมอ (ห้ามอ่านค่า Humanoid สด
                -- เพราะตอนซิงค์เราเขียน WalkSpeed ที่คูณแล้วลง Humanoid เอง อ่านสดแล้วคูณทบต่อ
                -- ความเร็วจะทวีคูณทุกเฟรมจนโดนเตะทันที)
                if ugBaseWalkSpeed and ugBaseWalkSpeed > 0.1 then
                        speed = ugBaseWalkSpeed
                elseif humanoid.WalkSpeed and humanoid.WalkSpeed > 0.1 then
                        speed = humanoid.WalkSpeed
                end
                -- Underground Speed (0.1 - 0.9): ล็อคเพดานที่ 0.9 = เร็วสุดที่ per-frame displacement ยังใต้ threshold
                --   (เกิน 0.9 = ระยะต่อเฟรมใหญ่เกิน เซิร์ฟปฏิเสธตำแหน่ง → ตกแมพ/วาป)
                local ugSpeedMult = tonumber(cheat.ug_state.speed) or 0.9
                if ugSpeedMult < 0.1 then
                        ugSpeedMult = 0.1
                elseif ugSpeedMult > 0.9 then
                        ugSpeedMult = 0.9
                end
                -- ★ ปรับความเร็วแล้วตัวกระชาก/โดนเกมเตะ: ไล่ค่าเร็วเข้าเป้าแบบนุ่ม ~0.3 วิ
                if ugSpeedSmooth == nil then
                        ugSpeedSmooth = ugSpeedMult
                end
                ugSpeedSmooth = ugSpeedSmooth + (ugSpeedMult - ugSpeedSmooth) * math.min(1, deltaTime * 10)
                if math.abs(ugSpeedMult - ugSpeedSmooth) < 0.02 then
                        ugSpeedSmooth = ugSpeedMult
                end
                ugSpeedMult = ugSpeedSmooth
                speed = speed * ugSpeedMult
                -- ★ UG vert fix: แยกความเร็วแนวตั้งตามทิศ — ทิศลง (จุ่มลง/ตามผิวลง) = ระดับการตกธรรมชาติ
                -- 40 หน่วย/วิ เร็วสุดที่ใช้มาแล้วไม่เคยโดนจับ (การตกเกมตรวจไม่ได้) ส่วนทิศขึ้น (ไต่ตามผิว/
                -- ขึ้นผิวตอนกดขึ้น) = จำกัดระดับความเร็วเดินแล้วซิงค์ WalkSpeed เพราะทิศขึ้นคือทิศเดียวที่เกม
                -- คิดว่าผิดปกติถ้าเร็วกว่า WalkSpeed (สาเหตุโดนเตะ NO CLIP ตอนกดขึ้นของเวอร์ชันเก่า)
                local ugVertBase = (ugBaseWalkSpeed and ugBaseWalkSpeed > 0.1) and ugBaseWalkSpeed or 16
                local ugVertDown = 40
                local ugVertUp
                if cheat.ug_state.syncwalk == false then
                        ugVertUp = math.clamp(ugVertBase, 14, 22)
                else
                        ugVertUp = math.clamp(ugVertBase * 1.2, 16, 24)
                end
                -- ★ UG speed sync (กันเตะ NO CLIP): เซิร์ฟเวอร์เทียบระยะที่ตัวย้ายจริงต่อวินาที กับ
                -- WalkSpeed ที่ Humanoid รายงาน (ปกติ 16) พอคูณความเร็ว 1.1+ ระยะต่อวินาทีเลยเกินของ = เตะ
                -- วิธีกัน: ขณะมุดและกำลังเดินอยู่ เขียน WalkSpeed ให้เท่าความเร็วที่ขยับจริง
                -- เซิร์ฟเวอร์เลยเห็นว่าเดินตามกฎ พอหยุดเดิน = คืน WalkSpeed เดิมทันที
                -- (ปิด/เปิดได้ที่ toggle ซิงค์ความเร็ว ถ้าปิดจะกลับไปใช้แบบเดิม)
                -- ★ จม/ไต่ตามผิว/ขึ้นผิว ไล่ระดับแบบนุ่ม ๆ (คำนวณก่อนซิงค์ เพื่อรู้อัตราแนวตั้งจริง)
                if ugRising then
                        -- ★ v49: ไต่ขึ้นทีละเฟรม "ไม่ anchor" - เซิร์ฟรับ movement ขึ้นปกติ
                        --   จนถึง targetY แล้ว stop(skip teleport) = ไม่มี teleport ให้จับ ไม่ตกโลก
                        local ugRootH = (savedRootHeight and savedRootHeight > 0.5) and savedRootHeight or 3.5
                        local ugSurfNow = ugProbeSurface(root, char) or lastGroundY or (targetY - ugRootH)
                        local ugGateY = ugSurfNow + ugRootH - 1.2
                        -- ★ v49: เอา ugGateY teleport ออก - teleport กลางทาง = anti-cheat จับ → ตกโลก เหมือนกัน
                        --   ปล่อยให้ไต่ขึ้นทีละเฟรมจนถึง targetY แล้วค่อย stop ด้านล่าง
                        local ugUpDiff = targetY - root.Position.Y
                        if ugUpDiff <= 0.15 then
                                -- ★ v50: รีไฟน์ targetY ที่ XZ ปัจจุบันก่อน stop กันติดในดิน→โดนเตะ
                                --   สาเหตุ: targetY เก่า (จาก ugStartRise) ค้าง ถ้าเดินขึ้นเนินระหว่างไต่
                                --   ผิวจริงสูงขึ้นแต่เป้ายังเดิม → ตัวถึงเป้าเก่าแต่ยังใต้ผิวจริง → คืน CanCollide ตอนในดิน → ติด→โดนเตะ
                                --   แก้: หาผิวจริงที่ XZ ปัจจุบัน ถ้ายังใต้ผิว = อัปเดตเป้า+clearance แล้วไต่ต่อ (ไม่ stop ไม่ teleport)
                                --        ถ้าเหนือผิวจริงแล้ว = stop (คืน CanCollide ตอนเหนือผิว+clearance = ปลอดภัย ไม่ติดดิน)
                                local standH = (savedRootHeight and savedRootHeight > 0.5) and savedRootHeight or 3.5
                                local realSurf = UGSurfaceAtXZ(root.Position.X, root.Position.Z, root.Position.Y + 8, char)
                                local correctY = (realSurf or (root.Position.Y - standH)) + standH + 0.3
                                if root.Position.Y >= correctY - 0.2 then
                                        ugRising = false
                                        ugRiseTargetY = nil
                                        pcall(function()
                                            local ugHum = char:FindFirstChildOfClass("Humanoid")
                                            if ugHum and ugHum.Health > 0 then
                                                ugHum:ChangeState(Enum.HumanoidStateType.Running)
                                            end
                                        end)
                                        stopUnderground(true)
                                        print("[MUZER] Underground OFF - ไต่ขึ้นผิวดินแล้ว (รีไฟน์ targetY กันติดในดิน/โดนเตะ)")
                                        return
                                else
                                        -- ยังใต้ผิวจริง = อัปเดตเป้าที่ผิวจริง+clearance แล้วไต่ต่อ (ตกลงไปที่ ugNextY ข้างล่าง)
                                        ugRiseTargetY = correctY
                                        targetY = correctY
                                end
                        end
                end
                local ugNextY
                if ugRising then
                        ugNextY = root.Position.Y + math.min(ugVertUp * deltaTime, math.max(targetY - root.Position.Y, 0))
                else
                        local ugYDiff = targetY - root.Position.Y
                        if ugYDiff > 0 then
                                -- ★ ผิวดินสูงขึ้น (เดินขึ้นเนิน) = ไต่ตามผิวขึ้นด้วย กันลึกสะสมจนพอกดขึ้นต้องไต่ยาว
                                ugNextY = root.Position.Y + math.min(ugVertUp * deltaTime, ugYDiff)
                        else
                                ugNextY = root.Position.Y - math.min(ugVertDown * deltaTime, -ugYDiff)
                        end
                end
                -- อัตราการ "ไต่ขึ้น" จริงต่อวินาที (ทิศลงคือการตกธรรมชาติ เกมไม่สน ไม่ต้องซิงค์)
                local ugVertRateUp = 0
                if ugNextY > root.Position.Y + 0.001 then
                        ugVertRateUp = (ugNextY - root.Position.Y) / deltaTime
                end
                if tick() < ugHoldUntil then
                        ugVertRateUp = 0
                end
                if cheat.ug_state.syncwalk ~= false and ugBaseWalkSpeed and humanoid.Parent
                        and not ugStealthAnchored then
                        local ugSyncTarget
                        if dir.Magnitude > 0.01 or ugVertRateUp > 0.1 then
                                -- ซิงค์ระยะรวมต่อวินาที (แนวนอน + อัตราไต่ขึ้น) ให้เกมเห็นว่าย้ายตาม WalkSpeed
                                local ugHorizSpeed = (dir.Magnitude > 0.01) and speed or 0
                                local ugTotalSpeed = math.sqrt((ugHorizSpeed * ugHorizSpeed) + (ugVertRateUp * ugVertRateUp))
                                ugSyncTarget = math.clamp(ugTotalSpeed, ugBaseWalkSpeed, 48)
                        elseif ugWalkSynced then
                                ugSyncTarget = ugBaseWalkSpeed
                        end
                        if ugSyncTarget and humanoid.WalkSpeed ~= ugSyncTarget then
                                pcall(function()
                                        humanoid.WalkSpeed = ugSyncTarget
                                end)
                                ugWalkSynced = (ugSyncTarget ~= ugBaseWalkSpeed)
                        end
                end
                -- ช่วง hold = ตัว "ยืน" เหนือผิวดินจริง (ขยับ XZ ต่อได้ตามปกติ)
                if tick() < ugHoldUntil and not ugRising and lastGroundY and savedRootHeight then
                        local holdPos = root.Position + dir * speed * deltaTime
                        holdPos = Vector3.new(holdPos.X, lastGroundY + savedRootHeight, holdPos.Z)
                        ugLastPose = CFrame.new(holdPos)
                                * CFrame.Angles(0, ugViewYaw or lastYaw or 0, 0)
                        -- ★ Miko-faithful: velocity ตรงการเดินช่วง hold (anti-speed-kick) ไม่ใช่ zero
                        ugLastVel = Vector3.new(dir.X * speed, 0, dir.Z * speed)
                        if root.Parent then
                                root.AssemblyLinearVelocity = ugLastVel
                                root.AssemblyAngularVelocity = Vector3.zero
                                root.CFrame = ugLastPose
                        end
                        return
                end
                -- ★ v45: หมด hold = จมกลับลงใต้ดินต่อตามปกติ (ยัง anchor เงียบอยู่
                -- ไม่ปลด anchor ตลอดโหมด - เดิมพอหมด hold ปลด anchor ทันที เกมเห็นตัวอยู่
                -- ใต้ดินเลยจับ rollback = ดึงกลับระหว่างมุด)

                local pos = root.Position + dir * speed * deltaTime
                pos = Vector3.new(pos.X, ugNextY, pos.Z)

                -- หัน root ตามมุมมองที่เราคุมอยู่ (yaw จากกล้อง)
                if ugViewYaw ~= 0 or ugViewPitch ~= 0 then
                        lastYaw = ugViewYaw
                elseif dir.Magnitude > 0.01 then
                        lastYaw = math.atan2(-dir.X, -dir.Z)
                end

                -- ★ v51 FPS: เอา CanCollide loop ออกจาก RenderStepped (ซ้ำ ugApplyPose ใน Heartbeat)
                --   ugApplyPose ปิด CanCollide+CanQuery+CanTouch ทุกเฟรมอยู่แล้ว (Heartbeat รันก่อน RenderStepped)
                --   เดิม parts loop รัน 3x/เฟรม (Stepped+Heartbeat+RenderStepped) เหลือ 1x = FPS ดีขึ้นมาก
                -- ★ Miko-faithful: root เคลื่อนจริง replicate ปกติ (ไม่ anchor ตลอดโหมด)
                --   re-anchor เฉพาะเมื่อ ugStealthAnchored (ช่วง hold ยิง/ไต่ขึ้น) ป้องกันเกมปลดเอง
                if ugStealthAnchored and not root.Anchored then
                        root.Anchored = true
                end
                local pose = CFrame.new(pos)
                        * CFrame.Angles(0, lastYaw, 0)
                        * CFrame.Angles(-math.pi / 2, 0, 0)
                ugLastPose = pose
                -- ★ Miko-faithful: velocity ตรงการเคลื่อนไหวของเฟรมนี้ (แนวนอน=ทิศเดิน แนวตั้ง=อัตราจม/ไต่)
                ugLastVel = Vector3.new(dir.X * speed, (ugNextY - root.Position.Y) / deltaTime, dir.Z * speed)
                if root.Parent then
                        root.AssemblyLinearVelocity = ugLastVel
                        root.AssemblyAngularVelocity = Vector3.zero
                        root.CFrame = pose
                end

                -- คงระดับกล้องเดิมสัมพัทธ์ผิวดิน รวม offset ความสูงริก + CameraOffset เดิม
                if humanoid.Parent then
                        -- ★ FPS fix v41 (ต้นฉบับ): คำนวณแล้วเขียนเฉพาะเมื่อค่าเปลี่ยน
                        -- ★ v51 แก้กล้องต่ำ/แทบติดพื้น: root ถูกหมุน prone(-90°X) แต่สูตรเดิมผสน
                        --   savedCameraWorldOffset(capture ตอน upright) กับ VectorToObjectSpace(ตอน prone) → กล้องต่ำ/มุมผิด
                        --   แก้: เป้า world = ผิวปัจจุบัน + ความสูงยืน + CameraOffset เดิม แล้วแปลง object space ทีเดียว
                        local ugCamWorldDelta = Vector3.new(
                                savedCameraOffset.X,
                                lastGroundY + savedRootHeight + savedCameraOffset.Y - root.Position.Y,
                                savedCameraOffset.Z)
                        local ugCamOff = root.CFrame:VectorToObjectSpace(ugCamWorldDelta)
                        if humanoid.CameraOffset ~= ugCamOff then
                                humanoid.CameraOffset = ugCamOff
                        end
                end
        end

        -- ── ลูปขับเคลื่อนหลัก: RenderStepped ทุกเฟรม (เกตปิดใน UpdateUnderground เอง) ──
        local ugDriverConn = nil
        if not ugDriverConn then
                ugDriverConn = ugTrackConnection(RunService.RenderStepped:Connect(function(deltaTime)
                        pcall(UpdateUnderground, deltaTime)
                end))
        end
        -- Unload: Library.Unload ไล่ Disconnect ทุกอย่างใน Utility.Connections
        -- ชิ้นนี้จึงเป็นตัวเคลียร์โหมด + คืนตัวละครตอนกด Unload ด้วย
        if UtilityConn then
                pcall(function()
                        table.insert(UtilityConn, {
                                Disconnect = function()
                                        cheat.ug_state.on = false
                                        pcall(stopUnderground)
                                end
                        })
                end)
        end

        -- ── ปุ่ม UI แท็บมูฟเม้น (แนวเดียวกับ Noclip) ──
        local movebox = ui.sections.movement_main
        local infobox = setmetatable({}, {__index = function() return function() end end})  -- ★ เอาหน้าข้อมูลขวาออก = no-op (Textbox calls ไม่ error)

        local ug_depth_slider, ug_speed_slider = nil, nil
        local ug_keybind = nil
