local QUEST_REMOTE_PATH = "Remotes.QuestUpdate"

-- ═══════════ ค่าจริงทั้งหมดที่ดักได้จาก Cobalt (ใช้งานได้จริงทั้งหมด) ═══════════
local ACTION_ACCEPT   = "Activate"   -- รับเควสต์
local ACTION_COMPLETE = "Complete"   -- ทำเควสต์เสร็จ
local ACTION_CLAIM    = "Claim"      -- รับรางวัล

