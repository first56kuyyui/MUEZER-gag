-- [เพิ่ม] ===== ESP: กล่อง + ชื่อ + ระยะ + แถบเลือด (GUI ล้วน ใช้วัตถุซ้ำ กันแลคมือถือ) =====
local ESP_COLOR_ZOMBIE = Color3.fromRGB(255, 70, 70)
local ESP_COLOR_PLAYER = Color3.fromRGB(80, 170, 255)
local espCache = {}

-- [เพิ่ม] เช็กยังมีชีวิตไหม (ซอมบี้: ใช้ Humanoid ถ้ามี ไม่มีค่อยดู attribute Dead/Health)
local function espAlive(rig)
	local hum = rig:FindFirstChildOfClass("Humanoid")
	if hum then return hum.Health > 0 end
	if rig:GetAttribute("Dead") == true then return false end
	local hpAttr = tonumber(rig:GetAttribute("Health"))
	if hpAttr ~= nil then return hpAttr > 0 end
	return true
end

