-- [เพิ่ม] วาดกล่อง ESP รอบ 1 เป้า (ย่อขยายตามระยะ หลุดจอซ่อน)
local function espDraw(cam, rig, color, label)
	local hrp = rig:FindFirstChild("HumanoidRootPart")
	if not hrp then
		local stale = espCache[rig]
		if stale then stale.box.Visible = false end
		return
	end
	local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
	if (not onScreen) or pos.Z <= 0 then
		local stale = espCache[rig]
		if stale then stale.box.Visible = false end
		return
	end
	local data = espCache[rig]
	if not data then
		data = espMake(color)
		data.box.Parent = visGui
		espCache[rig] = data
	end
	local topPos = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
	local botPos = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
	local boxH = math.abs(topPos.Y - botPos.Y)
	if boxH < 14 then boxH = 14 end
	if boxH > 420 then boxH = 420 end
	local boxW = boxH * 0.6
	if boxW < 12 then boxW = 12 end
	data.box.Visible = true
	data.box.Position = UDim2.fromOffset(math.floor(pos.X - boxW * 0.5 + 0.5), math.floor(pos.Y - boxH * 0.5 + 0.5))
	data.box.Size = UDim2.fromOffset(math.floor(boxW + 0.5), math.floor(boxH + 0.5))
	data.name.Text = label
	data.dist.Text = tostring(math.floor((cam.CFrame.Position - hrp.Position).Magnitude + 0.5)) .. " m"
	local hum = rig:FindFirstChildOfClass("Humanoid")
	local hpPct = 1
	if hum and hum.MaxHealth > 0 then
		hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
	end
	data.hpFill.Size = UDim2.new(hpPct, 0, 1, 0)
	data.hpFill.BackgroundColor3 = Color3.fromRGB(math.floor(255 * (1 - hpPct) + 0.5), math.floor(255 * hpPct + 0.5), 0)
end

-- [เพิ่ม] รวมเป้าทั้งหมด: ซอมบี้ใน AiZones (โครงสร้างเดียวกับตัวเลือกเป้าของสคริปต์ฐาน) + ผู้เล่นคนอื่น
local function espUpdate(cam)
	local seen = {}
	for _, zone in ipairs(v7:GetChildren()) do
		for _, rig in ipairs(zone:GetChildren()) do
			if rig:FindFirstChild("HumanoidRootPart") and espAlive(rig) then
				seen[rig] = true
				espDraw(cam, rig, ESP_COLOR_ZOMBIE, rig.Name)
			end
		end
	end
	for _, plr in ipairs(v4:GetPlayers()) do
		if plr ~= v5 and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			local plrHum = plr.Character:FindFirstChildOfClass("Humanoid")
			if plrHum and plrHum.Health > 0 then
				seen[plr.Character] = true
				espDraw(cam, plr.Character, ESP_COLOR_PLAYER, plr.DisplayName)
			end
		end
	end
	local toRemove = nil
	for rig, data in pairs(espCache) do
		if seen[rig] then
			data.miss = 0
		else
			data.miss = (data.miss or 0) + 1
			data.box.Visible = false
			if (rig.Parent == nil) or (data.miss > 300) then
				if toRemove == nil then toRemove = {} end
				table.insert(toRemove, rig)
			end
		end
	end
	if toRemove then
		for _, rig in ipairs(toRemove) do
			local data = espCache[rig]
			if data then
				data.box:Destroy()
				espCache[rig] = nil
			end
		end
	end
end

-- [เพิ่ม] ลูปวาดทุกเฟรม: วง FOV ตามค่าสคริปต์ฐาน + กล้องดึงใหม่ทุกเฟรม (เกิดใหม่/กล้องเปลี่ยนไม่พัง)
v1.RenderStepped:Connect(function()
	local cam = workspace.CurrentCamera
	if not cam then return end
	fovFrame.Visible = (FovCfg.Visible == true)
	local circleRadius = FovCfg.Radius or 300
	fovFrame.Size = UDim2.fromOffset(math.floor(circleRadius * 2 + 0.5), math.floor(circleRadius * 2 + 0.5))
	pcall(espUpdate, cam)
end)

